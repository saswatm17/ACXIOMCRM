@model IEnumerable<AcxiomCRM.ViewModels.LeadConversionReportItem>
@{
    ViewData["Title"] = "Lead Conversion Report";
    var filter = ViewBag.Filter as AcxiomCRM.ViewModels.ReportFilterViewModel;
    var totalLeads = Model.Count();
    var convertedCount = Model.Count(x => x.IsConverted);
    var rate = totalLeads > 0 ? (convertedCount * 100.0 / totalLeads) : 0.0;
    var totalRevenue = Model.Where(x => x.IsConverted).Sum(x => x.DealAmount ?? 0);
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a asp-action="Index">Reports Hub</a></li>
                <li class="breadcrumb-item active" aria-current="page">Lead Conversion</li>
            </ol>
        </nav>
        <h2 class="fw-bold mb-0"><i class="bi bi-funnel-fill text-success me-2"></i>Lead Conversion Report</h2>
    </div>
    <div>
        <a asp-action="LeadConversion" 
           asp-route-fromDate="@filter?.FromDate?.ToString("yyyy-MM-dd")" 
           asp-route-toDate="@filter?.ToDate?.ToString("yyyy-MM-dd")" 
           asp-route-staffId="@filter?.StaffId" 
           asp-route-export="true" 
           class="btn btn-success">
            <i class="bi bi-file-earmark-spreadsheet me-1"></i>Download CSV
        </a>
    </div>
</div>

<!-- KPI Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm p-3">
            <div class="text-muted small fw-semibold">TOTAL LEADS</div>
            <div class="fs-3 fw-bold text-dark">@totalLeads</div>
            <div class="text-muted small">In selected window</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm p-3">
            <div class="text-muted small fw-semibold">CONVERTED LEADS</div>
            <div class="fs-3 fw-bold text-success">@convertedCount</div>
            <div class="text-muted small">Promoted to Customer</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm p-3">
            <div class="text-muted small fw-semibold">CONVERSION RATE</div>
            <div class="fs-3 fw-bold text-primary">@rate.ToString("F1")%</div>
            <div class="text-muted small">Conversion efficacy</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm p-3">
            <div class="text-muted small fw-semibold">PIPELINE VALUE GENERATED</div>
            <div class="fs-3 fw-bold text-warning">₹@totalRevenue.ToString("N0")</div>
            <div class="text-muted small">From converted opportunities</div>
        </div>
    </div>
</div>

<!-- Filters -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="LeadConversion" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label small text-muted mb-1">From Date</label>
                <input type="date" name="fromDate" value="@filter?.FromDate?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
            </div>
            <div class="col-md-3">
                <label class="form-label small text-muted mb-1">To Date</label>
                <input type="date" name="toDate" value="@filter?.ToDate?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
            </div>
            <div class="col-md-4">
                <label class="form-label small text-muted mb-1">Assigned Executive</label>
                <select name="staffId" class="form-select form-select-sm">
                    <option value="">-- All Executives --</option>
                    @if (filter?.StaffList != null)
                    {
                        foreach (var item in filter.StaffList)
                        {
                            <option value="@item.Value" selected="@(item.Value == filter.StaffId)">@item.Text</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-sm btn-primary flex-grow-1"><i class="bi bi-filter me-1"></i>Filter</button>
                <a asp-action="LeadConversion" class="btn btn-sm btn-light border"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </form>
    </div>
</div>

<!-- Data Table -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-muted small text-uppercase">
                    <tr>
                        <th class="ps-3">Lead Code</th>
                        <th>Lead Name</th>
                        <th>Company</th>
                        <th>Source</th>
                        <th>Status</th>
                        <th>Created</th>
                        <th>Converted?</th>
                        <th>Customer / Deal</th>
                        <th>Assigned Staff</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="9" class="text-center py-5 text-muted">No lead records found matching criteria.</td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-3 fw-semibold text-secondary">@item.LeadCode</td>
                                <td class="fw-bold">@item.LeadName</td>
                                <td>@(item.CompanyName ?? "-")</td>
                                <td><span class="badge bg-light text-dark border">@item.Source</span></td>
                                <td>
                                    <span class="badge @(item.Status == "Converted" ? "bg-success" : item.Status == "Lost" ? "bg-danger" : "bg-info")">
                                        @item.Status
                                    </span>
                                </td>
                                <td>@item.CreatedDate.ToString("dd MMM yyyy")</td>
                                <td>
                                    @if (item.IsConverted)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle"><i class="bi bi-check-circle me-1"></i>Converted</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border">Open</span>
                                    }
                                </td>
                                <td>
                                    @if (item.IsConverted)
                                    {
                                        <div><strong>@item.CustomerName</strong></div>
                                        <div class="small text-muted">₹@(item.DealAmount?.ToString("N0") ?? "0")</div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>@(item.AssignedToStaff ?? "Unassigned")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
