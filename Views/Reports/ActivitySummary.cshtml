@model IEnumerable<AcxiomCRM.ViewModels.ActivitySummaryReportItem>
@{
    ViewData["Title"] = "Activity Summary Report";
    var filter = ViewBag.Filter as AcxiomCRM.ViewModels.ReportFilterViewModel;
    var totalActivities = Model.Sum(x => x.TotalActivities);
    var totalCalls = Model.Sum(x => x.CallsCount);
    var totalMeetings = Model.Sum(x => x.MeetingsCount);
    var totalCompleted = Model.Sum(x => x.CompletedCount);
    var avgCompletionRate = Model.Any() ? Model.Average(x => x.CompletionRate) : 0.0;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a asp-action="Index">Reports Hub</a></li>
                <li class="breadcrumb-item active" aria-current="page">Activity Summary</li>
            </ol>
        </nav>
        <h2 class="fw-bold mb-0"><i class="bi bi-clock-history text-info me-2"></i>Activity Summary Report</h2>
    </div>
    <div>
        <a asp-action="ActivitySummary" 
           asp-route-fromDate="@filter?.FromDate?.ToString("yyyy-MM-dd")" 
           asp-route-toDate="@filter?.ToDate?.ToString("yyyy-MM-dd")" 
           asp-route-staffId="@filter?.StaffId" 
           asp-route-export="true" 
           class="btn btn-info text-white fw-semibold">
            <i class="bi bi-file-earmark-spreadsheet me-1"></i>Download CSV
        </a>
    </div>
</div>

<!-- KPI Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm p-3">
            <div class="text-muted small fw-semibold">TOTAL TOUCHPOINTS</div>
            <div class="fs-3 fw-bold text-dark">@totalActivities</div>
            <div class="text-muted small">Logged activities</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm p-3">
            <div class="text-muted small fw-semibold">CALLS COMPLETED</div>
            <div class="fs-3 fw-bold text-primary">@totalCalls</div>
            <div class="text-muted small">Phone outreach</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm p-3">
            <div class="text-muted small fw-semibold">MEETINGS HELD</div>
            <div class="fs-3 fw-bold text-success">@totalMeetings</div>
            <div class="text-muted small">In-person & video calls</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm p-3">
            <div class="text-muted small fw-semibold">COMPLETION RATE</div>
            <div class="fs-3 fw-bold text-info">@avgCompletionRate.ToString("F1")%</div>
            <div class="text-muted small">@totalCompleted finished tasks</div>
        </div>
    </div>
</div>

<!-- Filters -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="ActivitySummary" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label small text-muted mb-1">From Date</label>
                <input type="date" name="fromDate" value="@filter?.FromDate?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
            </div>
            <div class="col-md-3">
                <label class="form-label small text-muted mb-1">To Date</label>
                <input type="date" name="toDate" value="@filter?.ToDate?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
            </div>
            <div class="col-md-4">
                <label class="form-label small text-muted mb-1">Assigned Executive</label>
                <select name="staffId" class="form-select form-select-sm">
                    <option value="">-- All Executives --</option>
                    @if (filter?.StaffList != null)
                    {
                        foreach (var item in filter.StaffList)
                        {
                            <option value="@item.Value" selected="@(item.Value == filter.StaffId)">@item.Text</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-sm btn-primary flex-grow-1"><i class="bi bi-filter me-1"></i>Filter</button>
                <a asp-action="ActivitySummary" class="btn btn-sm btn-light border"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </form>
    </div>
</div>

<!-- Data Table -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-muted small text-uppercase">
                    <tr>
                        <th class="ps-3">Staff Member</th>
                        <th>Total Activities</th>
                        <th>Calls</th>
                        <th>Meetings</th>
                        <th>Emails</th>
                        <th>Tasks</th>
                        <th>Completed</th>
                        <th>Completion Rate</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">No activity records logged.</td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-3 fw-bold">@item.StaffName</td>
                                <td class="fw-bold">@item.TotalActivities</td>
                                <td><span class="badge bg-primary-subtle text-primary border">@item.CallsCount Calls</span></td>
                                <td><span class="badge bg-success-subtle text-success border">@item.MeetingsCount Meetings</span></td>
                                <td><span class="badge bg-info-subtle text-info border">@item.EmailsCount Emails</span></td>
                                <td><span class="badge bg-secondary-subtle text-secondary border">@item.TasksCount Tasks</span></td>
                                <td class="fw-semibold text-success">@item.CompletedCount</td>
                                <td>
                                    <div class="d-flex align-items-center gap-2" style="min-width: 120px;">
                                        <div class="progress flex-grow-1" style="height: 6px;">
                                            <div class="progress-bar bg-info" role="progressbar" style="width: @item.CompletionRate%"></div>
                                        </div>
                                        <span class="small fw-bold">@item.CompletionRate.ToString("F1")%</span>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
