@model IEnumerable<AcxiomCRM.ViewModels.ReportIndexItem>
@{
    ViewData["Title"] = "Reports & Analytics Hub";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-bar-chart-line-fill text-primary me-2"></i>Reports & Analytics</h2>
        <p class="text-muted mb-0">Executive reporting suite for pipeline velocity, conversion metrics, team performance, and audit compliance.</p>
    </div>
    <div>
        <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 fs-6">
            <i class="bi bi-shield-check me-1"></i>Manager & Admin Suite
        </span>
    </div>
</div>

<div class="row g-4">
    @foreach (var report in Model)
    {
        <div class="col-md-6 col-lg-3">
            <div class="card h-100 shadow-sm border-0 report-card transition-all">
                <div class="card-body d-flex flex-column p-4">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div class="rounded-circle bg-@report.BadgeColor-subtle text-@report.BadgeColor p-3 d-inline-flex align-items-center justify-content-center" style="width: 54px; height: 54px;">
                            <i class="bi @report.Icon fs-4"></i>
                        </div>
                        <span class="badge bg-light text-secondary border">@report.Category</span>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">@report.Title</h5>
                    <p class="text-muted small flex-grow-1 mb-4">@report.Description</p>
                    <div class="d-flex gap-2 mt-auto">
                        <a asp-action="@report.ActionName" class="btn btn-outline-primary btn-sm flex-grow-1 fw-semibold">
                            <i class="bi bi-eye me-1"></i>View Report
                        </a>
                        <a asp-action="@report.ActionName" asp-route-export="true" class="btn btn-light btn-sm text-secondary border" title="Export as CSV">
                            <i class="bi bi-download"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .report-card {
        transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
    }
    .report-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 0.5rem 1.25rem rgba(0, 0, 0, 0.08) !important;
    }
</style>
