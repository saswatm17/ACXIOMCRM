@model IEnumerable<AcxiomCRM.ViewModels.CustomerAcquisitionReportItem>
@{
    ViewData["Title"] = "Customer Acquisition Report";
    var filter = ViewBag.Filter as AcxiomCRM.ViewModels.ReportFilterViewModel;
    var totalCustomers = Model.Count();
    var totalRevenue = Model.Sum(x => x.TotalRevenue);
    var totalDeals = Model.Sum(x => x.TotalOpportunitiesCount);
    var uniqueStates = Model.Where(x => !string.IsNullOrEmpty(x.State)).Select(x => x.State).Distinct().Count();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a asp-action="Index">Reports Hub</a></li>
                <li class="breadcrumb-item active" aria-current="page">Customer Acquisition</li>
            </ol>
        </nav>
        <h2 class="fw-bold mb-0"><i class="bi bi-building-fill-check text-primary me-2"></i>Customer Acquisition Report</h2>
    </div>
    <div>
        <a asp-action="CustomerAcquisition" 
           asp-route-fromDate="@filter?.FromDate?.ToString("yyyy-MM-dd")" 
           asp-route-toDate="@filter?.ToDate?.ToString("yyyy-MM-dd")" 
           asp-route-state="@filter?.State" 
           asp-route-export="true" 
           class="btn btn-primary">
            <i class="bi bi-file-earmark-spreadsheet me-1"></i>Download CSV
        </a>
    </div>
</div>

<!-- KPI Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm p-3">
            <div class="text-muted small fw-semibold">ACQUIRED CUSTOMERS</div>
            <div class="fs-3 fw-bold text-dark">@totalCustomers</div>
            <div class="text-muted small">Onboarded client accounts</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm p-3">
            <div class="text-muted small fw-semibold">REALIZED REVENUE</div>
            <div class="fs-3 fw-bold text-success">₹@totalRevenue.ToString("N0")</div>
            <div class="text-muted small">Cumulative won bookings</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm p-3">
            <div class="text-muted small fw-semibold">OPPORTUNITIES GENERATED</div>
            <div class="fs-3 fw-bold text-primary">@totalDeals</div>
            <div class="text-muted small">Associated deals</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm p-3">
            <div class="text-muted small fw-semibold">GEOGRAPHIC REACH</div>
            <div class="fs-3 fw-bold text-info">@uniqueStates States</div>
            <div class="text-muted small">Across India</div>
        </div>
    </div>
</div>

<!-- Filters -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="CustomerAcquisition" class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label small text-muted mb-1">From Date</label>
                <input type="date" name="fromDate" value="@filter?.FromDate?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
            </div>
            <div class="col-md-4">
                <label class="form-label small text-muted mb-1">To Date</label>
                <input type="date" name="toDate" value="@filter?.ToDate?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
            </div>
            <div class="col-md-2">
                <label class="form-label small text-muted mb-1">State</label>
                <input type="text" name="state" value="@filter?.State" placeholder="e.g. Maharashtra" class="form-control form-control-sm" />
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-sm btn-primary flex-grow-1"><i class="bi bi-filter me-1"></i>Filter</button>
                <a asp-action="CustomerAcquisition" class="btn btn-sm btn-light border"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </form>
    </div>
</div>

<!-- Data Table -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-muted small text-uppercase">
                    <tr>
                        <th class="ps-3">Customer Code</th>
                        <th>Customer Name</th>
                        <th>Company</th>
                        <th>Location</th>
                        <th>Acquired Date</th>
                        <th>Onboarded By</th>
                        <th>Total Deals</th>
                        <th>Realized Revenue</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">No customer acquisition records found.</td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-3 fw-semibold text-secondary">@item.CustomerCode</td>
                                <td class="fw-bold">@item.CustomerName</td>
                                <td>@(item.CompanyName ?? "-")</td>
                                <td>
                                    <div>@(item.City ?? "Unknown City")</div>
                                    <div class="small text-muted">@(item.State ?? "India")</div>
                                </td>
                                <td>@item.CreatedDate.ToString("dd MMM yyyy")</td>
                                <td>@(item.AcquiredByStaff ?? "System")</td>
                                <td class="fw-semibold">@item.TotalOpportunitiesCount</td>
                                <td class="fw-bold text-success">₹@item.TotalRevenue.ToString("N0")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
