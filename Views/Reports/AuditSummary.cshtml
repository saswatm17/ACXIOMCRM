@model IEnumerable<AcxiomCRM.ViewModels.AuditSummaryReportItem>
@{
    ViewData["Title"] = "Audit Trail Summary Report";
    var filter = ViewBag.Filter as AcxiomCRM.ViewModels.ReportFilterViewModel;
    var totalEvents = Model.Sum(x => x.EventCount);
    var uniqueEntities = Model.Select(x => x.EntityName).Distinct().Count();
    var uniqueUsers = Model.Select(x => x.StaffName).Distinct().Count();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a asp-action="Index">Reports Hub</a></li>
                <li class="breadcrumb-item active" aria-current="page">Audit Trail Summary</li>
            </ol>
        </nav>
        <h2 class="fw-bold mb-0"><i class="bi bi-shield-check text-dark me-2"></i>Audit Trail Summary Report</h2>
    </div>
    <div>
        <a asp-action="AuditSummary" 
           asp-route-fromDate="@filter?.FromDate?.ToString("yyyy-MM-dd")" 
           asp-route-toDate="@filter?.ToDate?.ToString("yyyy-MM-dd")" 
           asp-route-actionType="@filter?.Status" 
           asp-route-export="true" 
           class="btn btn-dark">
            <i class="bi bi-file-earmark-spreadsheet me-1"></i>Download CSV
        </a>
    </div>
</div>

<!-- KPI Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm p-3">
            <div class="text-muted small fw-semibold">TOTAL AUDITED EVENTS</div>
            <div class="fs-3 fw-bold text-dark">@totalEvents</div>
            <div class="text-muted small">Recorded system mutations</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm p-3">
            <div class="text-muted small fw-semibold">AUDITED ENTITIES</div>
            <div class="fs-3 fw-bold text-primary">@uniqueEntities Tables</div>
            <div class="text-muted small">Customer, Lead, Opp, FollowUp, etc.</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm p-3">
            <div class="text-muted small fw-semibold">ACTIVE ACTORS</div>
            <div class="fs-3 fw-bold text-success">@uniqueUsers Staff</div>
            <div class="text-muted small">Performing operations</div>
        </div>
    </div>
</div>

<!-- Filters -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="AuditSummary" class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label small text-muted mb-1">From Date</label>
                <input type="date" name="fromDate" value="@filter?.FromDate?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
            </div>
            <div class="col-md-4">
                <label class="form-label small text-muted mb-1">To Date</label>
                <input type="date" name="toDate" value="@filter?.ToDate?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
            </div>
            <div class="col-md-2">
                <label class="form-label small text-muted mb-1">Action Type</label>
                <select name="actionType" class="form-select form-select-sm">
                    <option value="">-- All Actions --</option>
                    @foreach (var act in new[] { "Create", "Update", "Delete", "Convert", "StageChange", "LoginSuccess", "LoginFailed", "PasswordReset", "UnlockAccount" })
                    {
                        <option value="@act" selected="@(act == filter?.Status)">@act</option>
                    }
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-sm btn-primary flex-grow-1"><i class="bi bi-filter me-1"></i>Filter</button>
                <a asp-action="AuditSummary" class="btn btn-sm btn-light border"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </form>
    </div>
</div>

<!-- Data Table -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-muted small text-uppercase">
                    <tr>
                        <th class="ps-3">Staff Actor</th>
                        <th>Action</th>
                        <th>Target Entity</th>
                        <th>Total Event Count</th>
                        <th>Most Recent Timestamp (UTC)</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">No audit summary records matching criteria.</td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-3 fw-bold">@item.StaffName</td>
                                <td>
                                    <span class="badge @(item.Action == "Create" ? "bg-success" : item.Action == "Delete" ? "bg-danger" : item.Action == "Convert" ? "bg-primary" : "bg-secondary")">
                                        @item.Action
                                    </span>
                                </td>
                                <td class="fw-semibold text-secondary">@item.EntityName</td>
                                <td class="fw-bold">@item.EventCount</td>
                                <td>@item.LastEventTimestamp.ToString("dd MMM yyyy, HH:mm:ss")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
