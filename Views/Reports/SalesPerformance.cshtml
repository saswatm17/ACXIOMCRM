@model IEnumerable<AcxiomCRM.ViewModels.SalesPerformanceReportItem>
@{
    ViewData["Title"] = "Sales Rep Performance Report";
    var filter = ViewBag.Filter as AcxiomCRM.ViewModels.ReportFilterViewModel;
    var totalReps = Model.Count();
    var totalWonDeals = Model.Sum(x => x.WonDealsCount);
    var totalWonRevenue = Model.Sum(x => x.TotalWonRevenue);
    var avgWinRate = totalReps > 0 ? Model.Average(x => x.WinRate) : 0.0;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a asp-action="Index">Reports Hub</a></li>
                <li class="breadcrumb-item active" aria-current="page">Rep Performance</li>
            </ol>
        </nav>
        <h2 class="fw-bold mb-0"><i class="bi bi-trophy-fill text-warning me-2"></i>Sales Rep Performance Report</h2>
    </div>
    <div>
        <a asp-action="SalesPerformance" 
           asp-route-fromDate="@filter?.FromDate?.ToString("yyyy-MM-dd")" 
           asp-route-toDate="@filter?.ToDate?.ToString("yyyy-MM-dd")" 
           asp-route-export="true" 
           class="btn btn-warning text-dark fw-semibold">
            <i class="bi bi-file-earmark-spreadsheet me-1"></i>Download CSV
        </a>
    </div>
</div>

<!-- KPI Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm p-3">
            <div class="text-muted small fw-semibold">ACTIVE REPS</div>
            <div class="fs-3 fw-bold text-dark">@totalReps</div>
            <div class="text-muted small">Sales team members</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm p-3">
            <div class="text-muted small fw-semibold">TOTAL WON DEALS</div>
            <div class="fs-3 fw-bold text-success">@totalWonDeals</div>
            <div class="text-muted small">Successfully closed</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm p-3">
            <div class="text-muted small fw-semibold">TOTAL WON REVENUE</div>
            <div class="fs-3 fw-bold text-primary">₹@totalWonRevenue.ToString("N0")</div>
            <div class="text-muted small">Total realized sales</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm p-3">
            <div class="text-muted small fw-semibold">AVERAGE WIN RATE</div>
            <div class="fs-3 fw-bold text-warning">@avgWinRate.ToString("F1")%</div>
            <div class="text-muted small">Team conversion average</div>
        </div>
    </div>
</div>

<!-- Filters -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="SalesPerformance" class="row g-2 align-items-end">
            <div class="col-md-5">
                <label class="form-label small text-muted mb-1">From Date</label>
                <input type="date" name="fromDate" value="@filter?.FromDate?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
            </div>
            <div class="col-md-5">
                <label class="form-label small text-muted mb-1">To Date</label>
                <input type="date" name="toDate" value="@filter?.ToDate?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-sm btn-primary flex-grow-1"><i class="bi bi-filter me-1"></i>Filter</button>
                <a asp-action="SalesPerformance" class="btn btn-sm btn-light border"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </form>
    </div>
</div>

<!-- Data Table -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-muted small text-uppercase">
                    <tr>
                        <th class="ps-3">Sales Executive</th>
                        <th>Email</th>
                        <th>Total Deals</th>
                        <th>Won Deals</th>
                        <th>Open Pipeline Value</th>
                        <th>Won Revenue</th>
                        <th>Win Rate</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">No sales performance data available.</td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model.OrderByDescending(x => x.TotalWonRevenue))
                        {
                            <tr>
                                <td class="ps-3 fw-bold">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rounded-circle bg-warning-subtle text-warning fw-bold d-flex align-items-center justify-content-center" style="width: 32px; height: 32px; font-size: 0.85rem;">
                                            @item.StaffName.Substring(0, Math.Min(2, item.StaffName.Length)).ToUpper()
                                        </div>
                                        <span>@item.StaffName</span>
                                    </div>
                                </td>
                                <td class="text-muted">@item.Email</td>
                                <td class="fw-semibold">@item.TotalDeals</td>
                                <td class="text-success fw-bold">@item.WonDealsCount</td>
                                <td>₹@item.TotalPipelineValue.ToString("N0")</td>
                                <td class="fw-bold text-primary">₹@item.TotalWonRevenue.ToString("N0")</td>
                                <td>
                                    <div class="d-flex align-items-center gap-2" style="min-width: 120px;">
                                        <div class="progress flex-grow-1" style="height: 6px;">
                                            <div class="progress-bar @(item.WinRate >= 50 ? "bg-success" : item.WinRate >= 25 ? "bg-warning" : "bg-danger")" 
                                                 role="progressbar" 
                                                 style="width: @item.WinRate%"></div>
                                        </div>
                                        <span class="small fw-bold">@item.WinRate.ToString("F1")%</span>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
