@model IEnumerable<AcxiomCRM.ViewModels.SalesPipelineReportItem>
@{
    ViewData["Title"] = "Sales Pipeline Report";
    var filter = ViewBag.Filter as AcxiomCRM.ViewModels.ReportFilterViewModel;
    var totalDeals = Model.Count();
    var totalAmount = Model.Sum(x => x.Amount);
    var weightedAmount = Model.Sum(x => x.WeightedAmount);
    var wonDealsAmount = Model.Where(x => x.Stage == "Closed Won").Sum(x => x.Amount);
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a asp-action="Index">Reports Hub</a></li>
                <li class="breadcrumb-item active" aria-current="page">Sales Pipeline</li>
            </ol>
        </nav>
        <h2 class="fw-bold mb-0"><i class="bi bi-currency-dollar text-primary me-2"></i>Sales Pipeline Report</h2>
    </div>
    <div>
        <a asp-action="Pipeline" 
           asp-route-stage="@filter?.Stage" 
           asp-route-staffId="@filter?.StaffId" 
           asp-route-export="true" 
           class="btn btn-primary">
            <i class="bi bi-file-earmark-spreadsheet me-1"></i>Download CSV
        </a>
    </div>
</div>

<!-- KPI Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm p-3">
            <div class="text-muted small fw-semibold">TOTAL DEALS</div>
            <div class="fs-3 fw-bold text-dark">@totalDeals</div>
            <div class="text-muted small">Active & closed deals</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm p-3">
            <div class="text-muted small fw-semibold">NOMINAL PIPELINE</div>
            <div class="fs-3 fw-bold text-primary">₹@totalAmount.ToString("N0")</div>
            <div class="text-muted small">Total face value</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm p-3">
            <div class="text-muted small fw-semibold">WEIGHTED PIPELINE</div>
            <div class="fs-3 fw-bold text-info">₹@weightedAmount.ToString("N0")</div>
            <div class="text-muted small">Probability adjusted</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm p-3">
            <div class="text-muted small fw-semibold">CLOSED WON REVENUE</div>
            <div class="fs-3 fw-bold text-success">₹@wonDealsAmount.ToString("N0")</div>
            <div class="text-muted small">Realized bookings</div>
        </div>
    </div>
</div>

<!-- Filters -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="Pipeline" class="row g-2 align-items-end">
            <div class="col-md-5">
                <label class="form-label small text-muted mb-1">Deal Stage</label>
                <select name="stage" class="form-select form-select-sm">
                    <option value="">-- All Pipeline Stages --</option>
                    @foreach (var stage in new[] { "Qualification", "Needs Analysis", "Proposal / Quote", "Negotiation", "Closed Won", "Closed Lost" })
                    {
                        <option value="@stage" selected="@(stage == filter?.Stage)">@stage</option>
                    }
                </select>
            </div>
            <div class="col-md-5">
                <label class="form-label small text-muted mb-1">Assigned Executive</label>
                <select name="staffId" class="form-select form-select-sm">
                    <option value="">-- All Executives --</option>
                    @if (filter?.StaffList != null)
                    {
                        foreach (var item in filter.StaffList)
                        {
                            <option value="@item.Value" selected="@(item.Value == filter.StaffId)">@item.Text</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-sm btn-primary flex-grow-1"><i class="bi bi-filter me-1"></i>Filter</button>
                <a asp-action="Pipeline" class="btn btn-sm btn-light border"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </form>
    </div>
</div>

<!-- Data Table -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-muted small text-uppercase">
                    <tr>
                        <th class="ps-3">Deal Name</th>
                        <th>Customer</th>
                        <th>Stage</th>
                        <th>Probability</th>
                        <th>Deal Amount</th>
                        <th>Weighted Value</th>
                        <th>Expected Close</th>
                        <th>Status</th>
                        <th>Assigned Staff</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="9" class="text-center py-5 text-muted">No pipeline records found matching criteria.</td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-3 fw-bold">@item.OpportunityName</td>
                                <td>@item.CustomerName</td>
                                <td><span class="badge bg-light text-dark border">@item.Stage</span></td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="progress flex-grow-1" style="height: 6px; width: 60px;">
                                            <div class="progress-bar bg-primary" role="progressbar" style="width: @item.Probability%"></div>
                                        </div>
                                        <span class="small fw-semibold">@item.Probability%</span>
                                    </div>
                                </td>
                                <td class="fw-bold">₹@item.Amount.ToString("N0")</td>
                                <td class="text-info fw-semibold">₹@item.WeightedAmount.ToString("N0")</td>
                                <td>@item.ExpectedCloseDate.ToString("dd MMM yyyy")</td>
                                <td>
                                    <span class="badge @(item.Status == "Won" ? "bg-success" : item.Status == "Lost" ? "bg-danger" : "bg-warning text-dark")">
                                        @item.Status
                                    </span>
                                </td>
                                <td>@item.AssignedToStaff</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
