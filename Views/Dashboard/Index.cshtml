@model AcxiomCRM.ViewModels.DashboardViewModel
@using AcxiomCRM.Models.Constants
@{
    ViewData["Title"] = "Executive Sales Dashboard";
}

<div class="container-fluid px-4 py-3">
    <!-- Welcome Header Banner -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 pb-3 mb-4 border-bottom">
        <div>
            <h2 class="fw-bold mb-1 text-dark">
                Welcome back, <span class="text-primary">@Model.FullName</span>!
            </h2>
            <div class="text-muted small">
                <span><i class="bi bi-envelope me-1"></i>@Model.Email</span>
                <span class="mx-2">&bull;</span>
                <span>Role: </span>
                @switch (Model.Role)
                {
                    case AppRoles.Admin:
                        <span class="badge bg-danger rounded-pill px-2 py-1"><i class="bi bi-shield-lock-fill me-1"></i> Administrator (Org-Wide View)</span>
                        break;
                    case AppRoles.Manager:
                        <span class="badge bg-primary rounded-pill px-2 py-1"><i class="bi bi-briefcase-fill me-1"></i> Sales Manager (Team View)</span>
                        break;
                    default:
                        <span class="badge bg-success rounded-pill px-2 py-1"><i class="bi bi-person-badge-fill me-1"></i> Sales Executive (My Pipeline)</span>
                        break;
                }
            </div>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-light text-dark border px-3 py-2 rounded-pill small me-2">
                <i class="bi bi-calendar3 me-1 text-primary"></i> @DateTime.Now.ToString("dddd, dd MMMM yyyy")
            </span>
            <div class="dropdown">
                <button class="btn btn-primary btn-sm rounded-pill shadow-sm dropdown-toggle" type="button" data-bs-toggle="dropdown">
                    <i class="bi bi-plus-circle me-1"></i> Quick Action
                </button>
                <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                    <li><a class="dropdown-item" asp-controller="Leads" asp-action="Create"><i class="bi bi-funnel me-2 text-success"></i> Add New Lead</a></li>
                    <li><a class="dropdown-item" asp-controller="Opportunities" asp-action="Create"><i class="bi bi-currency-dollar me-2 text-warning"></i> New Opportunity</a></li>
                    <li><a class="dropdown-item" asp-controller="FollowUps" asp-action="Create"><i class="bi bi-calendar-check me-2 text-info"></i> Schedule Follow-Up</a></li>
                    <li><a class="dropdown-item" asp-controller="Activities" asp-action="Create"><i class="bi bi-card-checklist me-2 text-primary"></i> Log Interaction</a></li>
                </ul>
            </div>
        </div>
    </div>

    <!-- 6 KPI Metric Cards -->
    <div class="row g-3 mb-4">
        <!-- 1. Active Customers -->
        <div class="col-sm-6 col-xl-2">
            <div class="card border-0 shadow-sm rounded-3 h-100 bg-white">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="text-muted small text-uppercase fw-semibold" style="font-size: 0.75rem;">Customers</span>
                        <div class="p-2 bg-primary-subtle text-primary rounded-3">
                            <i class="bi bi-building fs-5"></i>
                        </div>
                    </div>
                    <h3 class="fw-bold text-dark mb-0">@Model.TotalCustomers</h3>
                    <span class="small text-muted">Active accounts</span>
                </div>
            </div>
        </div>

        <!-- 2. Leads & Conversion Rate -->
        <div class="col-sm-6 col-xl-2">
            <div class="card border-0 shadow-sm rounded-3 h-100 bg-white">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="text-muted small text-uppercase fw-semibold" style="font-size: 0.75rem;">Leads</span>
                        <div class="p-2 bg-warning-subtle text-warning rounded-3">
                            <i class="bi bi-funnel-fill fs-5"></i>
                        </div>
                    </div>
                    <h3 class="fw-bold text-dark mb-0">@Model.TotalLeads</h3>
                    <span class="small text-success fw-semibold"><i class="bi bi-graph-up-arrow me-1"></i>@Model.LeadConversionRate% converted</span>
                </div>
            </div>
        </div>

        <!-- 3. Total Pipeline Value -->
        <div class="col-sm-6 col-xl-2">
            <div class="card border-0 shadow-sm rounded-3 h-100 bg-white">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="text-muted small text-uppercase fw-semibold" style="font-size: 0.75rem;">Total Pipeline</span>
                        <div class="p-2 bg-info-subtle text-info rounded-3">
                            <i class="bi bi-cash-stack fs-5"></i>
                        </div>
                    </div>
                    <h4 class="fw-bold text-dark mb-0">₹@Model.TotalPipelineValue.ToString("N0")</h4>
                    <span class="small text-muted">Active unclosed deals</span>
                </div>
            </div>
        </div>

        <!-- 4. Weighted Pipeline -->
        <div class="col-sm-6 col-xl-2">
            <div class="card border-0 shadow-sm rounded-3 h-100 bg-white">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="text-muted small text-uppercase fw-semibold" style="font-size: 0.75rem;">Weighted Pipeline</span>
                        <div class="p-2 bg-purple-subtle text-purple rounded-3" style="background-color: #ede9fe; color: #6d28d9;">
                            <i class="bi bi-calculator fs-5"></i>
                        </div>
                    </div>
                    <h4 class="fw-bold text-dark mb-0" style="color: #6d28d9;">₹@Model.WeightedPipelineValue.ToString("N0")</h4>
                    <span class="small text-muted">Amount &times; Probability</span>
                </div>
            </div>
        </div>

        <!-- 5. Closed Won Revenue -->
        <div class="col-sm-6 col-xl-2">
            <div class="card border-0 shadow-sm rounded-3 h-100 bg-white border-start border-success border-4">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="text-muted small text-uppercase fw-semibold" style="font-size: 0.75rem;">Won Revenue</span>
                        <div class="p-2 bg-success-subtle text-success rounded-3">
                            <i class="bi bi-trophy-fill fs-5"></i>
                        </div>
                    </div>
                    <h4 class="fw-bold text-success mb-0">₹@Model.ClosedWonValue.ToString("N0")</h4>
                    <span class="small text-muted">Closed won bookings</span>
                </div>
            </div>
        </div>

        <!-- 6. Urgent Tasks Due -->
        <div class="col-sm-6 col-xl-2">
            <div class="card border-0 shadow-sm rounded-3 h-100 bg-white @(Model.FollowUpsOverdueCount > 0 ? "border-start border-danger border-4" : "")">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="text-muted small text-uppercase fw-semibold" style="font-size: 0.75rem;">Follow-Ups Due</span>
                        <div class="p-2 bg-danger-subtle text-danger rounded-3">
                            <i class="bi bi-alarm-fill fs-5"></i>
                        </div>
                    </div>
                    <h3 class="fw-bold @(Model.FollowUpsOverdueCount > 0 ? "text-danger" : "text-dark") mb-0">
                        @Model.FollowUpsDueTodayCount
                    </h3>
                    <span class="small @(Model.FollowUpsOverdueCount > 0 ? "text-danger fw-semibold" : "text-muted")">
                        @(Model.FollowUpsOverdueCount > 0 ? $"{Model.FollowUpsOverdueCount} Overdue / Missed" : "0 overdue items")
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- 3 Dynamic Chart.js Analytics Visualizations -->
    <div class="row g-4 mb-4">
        <!-- Chart 1: Lead Status Distribution (Doughnut Chart) -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                    <h6 class="fw-bold mb-0 text-dark">
                        <i class="bi bi-pie-chart-fill text-warning me-2"></i>Lead Status Breakdown
                    </h6>
                    <span class="badge bg-light text-muted border small">Total: @Model.TotalLeads</span>
                </div>
                <div class="card-body d-flex flex-column justify-content-center align-items-center p-3">
                    <div style="position: relative; width: 100%; max-height: 260px;">
                        <canvas id="leadStatusChart"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <!-- Chart 2: Pipeline by Stage (Bar Chart) -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                    <h6 class="fw-bold mb-0 text-dark">
                        <i class="bi bi-bar-chart-fill text-primary me-2"></i>Pipeline Revenue by Stage
                    </h6>
                    <a asp-controller="Opportunities" asp-action="Pipeline" class="small text-decoration-none">Kanban View &rarr;</a>
                </div>
                <div class="card-body p-3">
                    <div style="position: relative; width: 100%; height: 260px;">
                        <canvas id="pipelineStageChart"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <!-- Chart 3: Monthly Sales Trend (Line Chart) -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                    <h6 class="fw-bold mb-0 text-dark">
                        <i class="bi bi-graph-up text-success me-2"></i>Won Sales Trend (6 Months)
                    </h6>
                    <span class="badge bg-success-subtle text-success small">Closed Won</span>
                </div>
                <div class="card-body p-3">
                    <div style="position: relative; width: 100%; height: 260px;">
                        <canvas id="monthlySalesChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Urgent Follow-Ups & Active Pipeline Widgets -->
    <div class="row g-4 mb-4">
        <!-- Left: Urgent Follow-Ups Due Today / Overdue -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                    <h6 class="fw-bold mb-0 text-dark">
                        <i class="bi bi-calendar-check-fill text-danger me-2"></i>Urgent Follow-Ups Schedule
                    </h6>
                    <a asp-controller="FollowUps" asp-action="Index" class="small text-decoration-none">View All (@Model.FollowUpsDueTodayCount)</a>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr class="small text-muted text-uppercase">
                                    <th>Client / Prospect</th>
                                    <th>Type</th>
                                    <th>Scheduled Date & Time</th>
                                    <th>Status</th>
                                    <th class="text-end">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!Model.UrgentFollowUps.Any())
                                {
                                    <tr>
                                        <td colspan="5" class="text-center py-4 text-muted small">
                                            <i class="bi bi-check-circle fs-3 text-success d-block mb-1"></i>
                                            All follow-ups are up to date! No urgent items pending.
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    foreach (var f in Model.UrgentFollowUps)
                                    {
                                        var isOverdue = (f.Status == FollowUpStatus.Planned && f.FollowUpDate < DateTime.UtcNow) || f.Status == FollowUpStatus.Missed;
                                        <tr>
                                            <td>
                                                @if (f.Customer != null)
                                                {
                                                    <a asp-controller="Customers" asp-action="Details" asp-route-id="@f.CustomerId" class="fw-bold text-dark text-decoration-none small d-block">
                                                        @f.Customer.CustomerName
                                                    </a>
                                                    <span class="badge bg-primary-subtle text-primary py-0" style="font-size: 0.7rem;">Customer</span>
                                                }
                                                else if (f.Lead != null)
                                                {
                                                    <a asp-controller="Leads" asp-action="Details" asp-route-id="@f.LeadId" class="fw-bold text-dark text-decoration-none small d-block">
                                                        @f.Lead.LeadName
                                                    </a>
                                                    <span class="badge bg-warning-subtle text-warning py-0" style="font-size: 0.7rem;">Lead</span>
                                                }
                                            </td>
                                            <td>
                                                <span class="small">@f.FollowUpType</span>
                                            </td>
                                            <td>
                                                <div class="small @(isOverdue ? "text-danger fw-bold" : "text-dark")">
                                                    @f.FollowUpDate.ToString("dd MMM, hh:mm tt")
                                                </div>
                                            </td>
                                            <td>
                                                @if (isOverdue)
                                                {
                                                    <span class="badge bg-danger small">Overdue</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-primary small">Scheduled</span>
                                                }
                                            </td>
                                            <td class="text-end">
                                                <a asp-controller="FollowUps" asp-action="Details" asp-route-id="@f.FollowUpId" class="btn btn-sm btn-outline-primary py-0 px-2 small">
                                                    Manage
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right: Top Active Opportunities -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                    <h6 class="fw-bold mb-0 text-dark">
                        <i class="bi bi-cash-coin text-success me-2"></i>Top High-Value Deals in Pipeline
                    </h6>
                    <a asp-controller="Opportunities" asp-action="Index" class="small text-decoration-none">All Opportunities &rarr;</a>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr class="small text-muted text-uppercase">
                                    <th>Deal Name</th>
                                    <th>Account</th>
                                    <th>Amount (₹)</th>
                                    <th>Stage</th>
                                    <th class="text-end">Prob.</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!Model.TopActiveDeals.Any())
                                {
                                    <tr>
                                        <td colspan="5" class="text-center py-4 text-muted small">
                                            No active open opportunities in pipeline.
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    foreach (var opp in Model.TopActiveDeals)
                                    {
                                        <tr>
                                            <td>
                                                <a asp-controller="Opportunities" asp-action="Details" asp-route-id="@opp.OpportunityId" class="fw-bold text-dark text-decoration-none small d-block">
                                                    @opp.OpportunityName
                                                </a>
                                            </td>
                                            <td>
                                                <span class="small text-muted">@(opp.Customer?.CustomerName ?? "Prospect")</span>
                                            </td>
                                            <td>
                                                <span class="fw-bold text-dark small">₹@opp.Amount.ToString("N0")</span>
                                            </td>
                                            <td>
                                                <span class="badge bg-primary-subtle text-primary small">@opp.Stage</span>
                                            </td>
                                            <td class="text-end">
                                                <span class="badge bg-light text-dark border small">@opp.Probability%</span>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Chart 1: Lead Status Distribution (Doughnut Chart)
            const leadCtx = document.getElementById("leadStatusChart");
            if (leadCtx) {
                new Chart(leadCtx, {
                    type: "doughnut",
                    data: {
                        labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.LeadStatusLabels)),
                        datasets: [{
                            data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.LeadStatusCounts)),
                            backgroundColor: [
                                "#3b82f6", // New
                                "#06b6d4", // Contacted
                                "#10b981", // Qualified
                                "#8b5cf6", // Converted
                                "#ef4444"  // Lost
                            ],
                            borderWidth: 2,
                            borderColor: "#ffffff"
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                position: "bottom",
                                labels: { boxWidth: 12, font: { size: 11 } }
                            }
                        },
                        cutout: "68%"
                    }
                });
            }

            // Chart 2: Pipeline Revenue by Stage (Bar Chart)
            const stageCtx = document.getElementById("pipelineStageChart");
            if (stageCtx) {
                new Chart(stageCtx, {
                    type: "bar",
                    data: {
                        labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.StageLabels)),
                        datasets: [{
                            label: "Total Value (₹)",
                            data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.StageValues)),
                            backgroundColor: "#3b82f6",
                            borderRadius: 6
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                callbacks: {
                                    label: function(context) {
                                        return "₹ " + Number(context.raw).toLocaleString('en-IN');
                                    }
                                }
                            }
                        },
                        scales: {
                            y: {
                                beginAtZero: true,
                                ticks: {
                                    callback: function(value) {
                                        return "₹" + (value >= 100000 ? (value / 100000) + "L" : value);
                                    },
                                    font: { size: 10 }
                                },
                                grid: { color: "#f1f5f9" }
                            },
                            x: {
                                grid: { display: false },
                                ticks: { font: { size: 10 } }
                            }
                        }
                    }
                });
            }

            // Chart 3: Monthly Won Sales Trend (Line Chart)
            const salesCtx = document.getElementById("monthlySalesChart");
            if (salesCtx) {
                new Chart(salesCtx, {
                    type: "line",
                    data: {
                        labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyRevenueLabels)),
                        datasets: [{
                            label: "Won Revenue (₹)",
                            data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyRevenueValues)),
                            borderColor: "#10b981",
                            backgroundColor: "rgba(16, 185, 129, 0.15)",
                            borderWidth: 3,
                            fill: true,
                            tension: 0.35,
                            pointBackgroundColor: "#10b981",
                            pointRadius: 4
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                callbacks: {
                                    label: function(context) {
                                        return "Won: ₹ " + Number(context.raw).toLocaleString('en-IN');
                                    }
                                }
                            }
                        },
                        scales: {
                            y: {
                                beginAtZero: true,
                                ticks: {
                                    callback: function(value) {
                                        return "₹" + (value >= 100000 ? (value / 100000) + "L" : value);
                                    },
                                    font: { size: 10 }
                                },
                                grid: { color: "#f1f5f9" }
                            },
                            x: {
                                grid: { display: false },
                                ticks: { font: { size: 10 } }
                            }
                        }
                    }
                });
            }
        });
    </script>
}
