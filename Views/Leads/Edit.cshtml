@model AcxiomCRM.ViewModels.LeadFormViewModel
@using AcxiomCRM.Models.Constants
@{
    ViewData["Title"] = "Edit Lead";
}

<div class="row justify-content-center py-2">
    <div class="col-lg-8">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <div>
                <h3 class="fw-bold mb-1">
                    <i class="bi bi-pencil-square text-primary me-2"></i>Edit Lead
                </h3>
                <p class="text-secondary small mb-0">Update lead @Model.LeadCode details and stage status</p>
            </div>
            <a asp-action="Details" asp-route-id="@Model.LeadId" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                <i class="bi bi-arrow-left me-1"></i> Back to Details
            </a>
        </div>

        <div class="card border-0 shadow-sm rounded-4 bg-white">
            <div class="card-body p-4 p-md-5">
                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="LeadId" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-4" role="alert"></div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label asp-for="LeadCode" class="form-label fw-semibold small text-secondary"></label>
                            <input asp-for="LeadCode" class="form-control bg-light" readonly />
                        </div>
                        <div class="col-md-8">
                            <label asp-for="LeadName" class="form-label fw-semibold small text-secondary"></label>
                            <input asp-for="LeadName" class="form-control" autofocus />
                            <span asp-validation-for="LeadName" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label fw-semibold small text-secondary"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted"><i class="bi bi-envelope"></i></span>
                                <input asp-for="Email" class="form-control" />
                            </div>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Phone" class="form-label fw-semibold small text-secondary"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted"><i class="bi bi-telephone"></i></span>
                                <input asp-for="Phone" class="form-control" maxlength="10" />
                            </div>
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="CompanyName" class="form-label fw-semibold small text-secondary"></label>
                            <input asp-for="CompanyName" class="form-control" />
                            <span asp-validation-for="CompanyName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Source" class="form-label fw-semibold small text-secondary"></label>
                            <select asp-for="Source" class="form-select">
                                @foreach (var src in LeadSource.All)
                                {
                                    <option value="@src" selected="@(Model.Source == src)">@src</option>
                                }
                            </select>
                            <span asp-validation-for="Source" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-4">
                            <label asp-for="Status" class="form-label fw-semibold small text-secondary"></label>
                            <select asp-for="Status" class="form-select">
                                @foreach (var s in LeadStatus.All)
                                {
                                    <option value="@s" selected="@(Model.Status == s)">@s</option>
                                }
                            </select>
                            <span asp-validation-for="Status" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="ExpectedValue" class="form-label fw-semibold small text-secondary"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted">₹</span>
                                <input asp-for="ExpectedValue" class="form-control" type="number" step="1000" />
                            </div>
                            <span asp-validation-for="ExpectedValue" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="AssignedTo" class="form-label fw-semibold small text-secondary"></label>
                            <select asp-for="AssignedTo" asp-items="Model.UsersList" class="form-select"></select>
                            <span asp-validation-for="AssignedTo" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="alert alert-light border small text-muted mb-4 py-2">
                        <i class="bi bi-info-circle me-1 text-primary"></i>
                        <strong>Status Workflow:</strong> New &rarr; Contacted &rarr; Qualified &rarr; Converted. Direct jumps to Converted without Qualified status are blocked.
                    </div>

                    <div class="d-flex justify-content-end gap-2 pt-2 border-top">
                        <a asp-action="Details" asp-route-id="@Model.LeadId" class="btn btn-light rounded-pill px-4">Cancel</a>
                        <button type="submit" class="btn btn-primary rounded-pill px-4 shadow-sm">
                            <i class="bi bi-check2-circle me-1"></i> Update Lead
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
