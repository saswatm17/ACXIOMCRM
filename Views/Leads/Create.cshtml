@model AcxiomCRM.ViewModels.LeadFormViewModel
@using AcxiomCRM.Models.Constants
@{
    ViewData["Title"] = "Add Lead";
}

<div class="row justify-content-center py-2">
    <div class="col-lg-8">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <div>
                <h3 class="fw-bold mb-1">
                    <i class="bi bi-funnel-fill text-success me-2"></i>Add Lead
                </h3>
                <p class="text-secondary small mb-0">Record a new sales prospect inquiry in AcxiomCRM</p>
            </div>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                <i class="bi bi-arrow-left me-1"></i> Back to List
            </a>
        </div>

        <div class="card border-0 shadow-sm rounded-4 bg-white">
            <div class="card-body p-4 p-md-5">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-4" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="LeadName" class="form-label fw-semibold small text-secondary"></label>
                        <input asp-for="LeadName" class="form-control" placeholder="e.g. Vikram Malhotra" autofocus />
                        <span asp-validation-for="LeadName" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label fw-semibold small text-secondary"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted"><i class="bi bi-envelope"></i></span>
                                <input asp-for="Email" class="form-control" placeholder="vikram@enterprise.in" />
                            </div>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Phone" class="form-label fw-semibold small text-secondary"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted"><i class="bi bi-telephone"></i></span>
                                <input asp-for="Phone" class="form-control" placeholder="9812345678" maxlength="10" />
                            </div>
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="CompanyName" class="form-label fw-semibold small text-secondary"></label>
                            <input asp-for="CompanyName" class="form-control" placeholder="e.g. Apex Health Systems" />
                            <span asp-validation-for="CompanyName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Source" class="form-label fw-semibold small text-secondary"></label>
                            <select asp-for="Source" class="form-select">
                                @foreach (var src in LeadSource.All)
                                {
                                    <option value="@src">@src</option>
                                }
                            </select>
                            <span asp-validation-for="Source" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="ExpectedValue" class="form-label fw-semibold small text-secondary"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted">₹</span>
                                <input asp-for="ExpectedValue" class="form-control" type="number" step="1000" placeholder="50000" />
                            </div>
                            <span asp-validation-for="ExpectedValue" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="AssignedTo" class="form-label fw-semibold small text-secondary"></label>
                            <select asp-for="AssignedTo" asp-items="Model.UsersList" class="form-select">
                                <option value="">-- Assign to Me / Default --</option>
                            </select>
                            <span asp-validation-for="AssignedTo" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 pt-2 border-top">
                        <a asp-action="Index" class="btn btn-light rounded-pill px-4">Cancel</a>
                        <button type="submit" class="btn btn-primary rounded-pill px-4 shadow-sm">
                            <i class="bi bi-check2-circle me-1"></i> Save Lead
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
