@model AcxiomCRM.ViewModels.LeadListViewModel
@using AcxiomCRM.Models.Constants
@{
    ViewData["Title"] = "Lead Management";
}

<div class="container-fluid py-2">
    <!-- Breadcrumb & Header -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 pb-3 mb-3 border-bottom">
        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-funnel-fill text-success me-2"></i>Leads
            </h2>
            <p class="text-secondary small mb-0">Track prospect inquiries, qualification workflow, and conversion to deals</p>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-primary rounded-pill px-4 shadow-sm">
                <i class="bi bi-plus-circle-fill me-1"></i> Add Lead
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Search & Filter Card -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 bg-white">
        <div class="card-body p-3">
            <form method="get" asp-action="Index" class="row g-2 align-items-center">
                <div class="col-md-4">
                    <div class="input-group">
                        <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-search"></i></span>
                        <input type="text" name="search" value="@Model.SearchTerm" class="form-control border-start-0" placeholder="Search by name, company, email..." />
                    </div>
                </div>
                <div class="col-md-2">
                    <select name="status" class="form-select">
                        <option value="All" selected="@(string.IsNullOrEmpty(Model.SelectedStatus) || Model.SelectedStatus == "All")">All Statuses</option>
                        @foreach (var s in LeadStatus.All)
                        {
                            <option value="@s" selected="@(Model.SelectedStatus == s)">@s</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <select name="source" class="form-select">
                        <option value="All" selected="@(string.IsNullOrEmpty(Model.SelectedSource) || Model.SelectedSource == "All")">All Sources</option>
                        @foreach (var src in LeadSource.All)
                        {
                            <option value="@src" selected="@(Model.SelectedSource == src)">@src</option>
                        }
                    </select>
                </div>
                @if (User.IsInRole(AppRoles.Admin) || User.IsInRole(AppRoles.Manager))
                {
                    <div class="col-md-2">
                        <select name="assignedTo" class="form-select">
                            <option value="All" selected="@(string.IsNullOrEmpty(Model.SelectedAssignedTo) || Model.SelectedAssignedTo == "All")">All Assignees</option>
                            @foreach (var u in Model.UsersList)
                            {
                                <option value="@u.Value" selected="@(Model.SelectedAssignedTo == u.Value)">@u.Text</option>
                            }
                        </select>
                    </div>
                }
                <div class="col d-flex gap-2 justify-content-end">
                    <button type="submit" class="btn btn-primary px-3 rounded-3">
                        <i class="bi bi-funnel me-1"></i> Filter
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary px-3 rounded-3">
                        <i class="bi bi-arrow-counterclockwise me-1"></i> Reset
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Leads Table Card -->
    <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-secondary small text-uppercase">
                    <tr>
                        <th class="ps-4">Code</th>
                        <th>Lead Name</th>
                        <th>Company</th>
                        <th>Source</th>
                        <th>Status</th>
                        <th>Expected Value</th>
                        <th>Assigned To</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Leads.Any())
                    {
                        foreach (var item in Model.Leads)
                        {
                            var statusBadge = item.Status switch
                            {
                                "New" => "bg-primary-subtle text-primary border-primary-subtle",
                                "Contacted" => "bg-info-subtle text-info-emphasis border-info-subtle",
                                "Qualified" => "bg-success-subtle text-success border-success-subtle",
                                "Converted" => "bg-purple-subtle text-primary border-primary-subtle fw-bold",
                                "Unqualified" => "bg-secondary-subtle text-secondary border-secondary-subtle",
                                "Lost" => "bg-danger-subtle text-danger border-danger-subtle",
                                _ => "bg-light text-dark"
                            };

                            <tr>
                                <td class="ps-4 fw-semibold text-primary">
                                    @item.LeadCode
                                </td>
                                <td>
                                    <a asp-action="Details" asp-route-id="@item.LeadId" class="fw-bold text-dark text-decoration-none">
                                        @item.LeadName
                                    </a>
                                    <div class="text-muted small">@item.Email</div>
                                </td>
                                <td class="small text-secondary">
                                    @(item.CompanyName ?? "—")
                                </td>
                                <td class="small">
                                    <span class="badge bg-light text-dark border">@item.Source</span>
                                </td>
                                <td>
                                    <span class="badge border rounded-pill px-2 py-1 @statusBadge">
                                        @item.Status
                                    </span>
                                </td>
                                <td class="fw-bold text-dark">
                                    ₹@item.ExpectedValue.ToString("N0")
                                </td>
                                <td class="small text-muted">
                                    @(item.AssignedToUser?.FullName ?? "Unassigned")
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@item.LeadId" class="btn btn-outline-secondary" title="View Details">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        @if (item.Status != LeadStatus.Converted)
                                        {
                                            <a asp-action="Edit" asp-route-id="@item.LeadId" class="btn btn-outline-primary" title="Edit Lead">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                        }
                                        @if (item.Status == LeadStatus.Qualified)
                                        {
                                            <a asp-action="Convert" asp-route-id="@item.LeadId" class="btn btn-outline-success fw-semibold" title="Convert to Customer & Opportunity">
                                                <i class="bi bi-arrow-repeat me-1"></i>Convert
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <div class="py-3">
                                    <i class="bi bi-funnel display-6 d-block mb-2 text-secondary opacity-50"></i>
                                    <h5>No leads found</h5>
                                    <p class="small text-muted mb-3">Adjust your search filters or create a new lead to start pipeline tracking.</p>
                                    <a asp-action="Create" class="btn btn-sm btn-primary rounded-pill px-3">
                                        <i class="bi bi-plus me-1"></i> Add Lead
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPages > 1)
        {
            <div class="card-footer bg-white d-flex justify-content-between align-items-center py-3 border-top">
                <span class="text-muted small">
                    Showing page <strong>@Model.CurrentPage</strong> of <strong>@Model.TotalPages</strong> (Total: @Model.TotalCount leads)
                </span>
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                            <a class="page-link" asp-action="Index"
                               asp-route-page="@(Model.CurrentPage - 1)"
                               asp-route-search="@Model.SearchTerm"
                               asp-route-status="@Model.SelectedStatus"
                               asp-route-source="@Model.SelectedSource"
                               asp-route-assignedTo="@Model.SelectedAssignedTo">Previous</a>
                        </li>
                        @for (int p = 1; p <= Model.TotalPages; p++)
                        {
                            <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                                <a class="page-link" asp-action="Index"
                                   asp-route-page="@p"
                                   asp-route-search="@Model.SearchTerm"
                                   asp-route-status="@Model.SelectedStatus"
                                   asp-route-source="@Model.SelectedSource"
                                   asp-route-assignedTo="@Model.SelectedAssignedTo">@p</a>
                            </li>
                        }
                        <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                            <a class="page-link" asp-action="Index"
                               asp-route-page="@(Model.CurrentPage + 1)"
                               asp-route-search="@Model.SearchTerm"
                               asp-route-status="@Model.SelectedStatus"
                               asp-route-source="@Model.SelectedSource"
                               asp-route-assignedTo="@Model.SelectedAssignedTo">Next</a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>
