@model AcxiomCRM.Models.Lead
@using AcxiomCRM.Models.Constants
@{
    ViewData["Title"] = $"{Model.LeadName} - Lead Details";

    var steps = new[] { LeadStatus.New, LeadStatus.Contacted, LeadStatus.Qualified, LeadStatus.Converted };
    var currentStepIndex = Array.IndexOf(steps, Model.Status);
}

<div class="container-fluid py-2">
    <!-- Header banner -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 pb-3 mb-4 border-bottom">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 rounded-pill fw-semibold">
                    @Model.LeadCode
                </span>
                <h2 class="fw-bold mb-0">@Model.LeadName</h2>
                <span class="badge @(Model.Status == LeadStatus.Converted ? "bg-primary" : "bg-dark") rounded-pill px-3 py-1">
                    @Model.Status
                </span>
            </div>
            <p class="text-secondary small mb-0">
                <i class="bi bi-building me-1"></i>@(Model.CompanyName ?? "Individual Prospect") &bull;
                <i class="bi bi-person me-1 ms-2"></i>Assigned to <strong>@(Model.AssignedToUser?.FullName ?? "Unassigned")</strong> &bull;
                <i class="bi bi-clock me-1 ms-2"></i>Created @Model.CreatedDate.ToString("dd MMM yyyy")
            </p>
        </div>
        <div class="d-flex gap-2 align-items-center">
            @if (Model.Status == LeadStatus.Qualified)
            {
                <a asp-action="Convert" asp-route-id="@Model.LeadId" class="btn btn-success rounded-pill px-4 shadow-sm fw-semibold">
                    <i class="bi bi-arrow-repeat me-1"></i> Convert to Customer & Deal
                </a>
            }
            @if (Model.Status != LeadStatus.Converted)
            {
                <a asp-action="Edit" asp-route-id="@Model.LeadId" class="btn btn-outline-primary rounded-pill px-3">
                    <i class="bi bi-pencil me-1"></i> Edit
                </a>
            }
            else if (Model.CustomerId.HasValue)
            {
                <a asp-controller="Customers" asp-action="Details" asp-route-id="@Model.CustomerId" class="btn btn-outline-primary rounded-pill px-3">
                    <i class="bi bi-box-arrow-up-right me-1"></i> View Converted Customer
                </a>
            }
            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3">
                <i class="bi bi-arrow-left me-1"></i> Back to List
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Workflow Progress Bar -->
    <div class="card border-0 shadow-sm rounded-4 bg-white mb-4 p-4">
        <h6 class="fw-bold text-muted text-uppercase small mb-3">
            <i class="bi bi-diagram-3-fill text-primary me-2"></i>Lead Qualification Lifecycle
        </h6>
        <div class="row g-2 text-center">
            @for (int i = 0; i < steps.Length; i++)
            {
                var stepName = steps[i];
                var isCompleted = currentStepIndex >= i && currentStepIndex != -1;
                var isCurrent = Model.Status == stepName;

                <div class="col-md-3">
                    <div class="p-3 rounded-3 border @(isCurrent ? "bg-primary text-white border-primary shadow-sm" : isCompleted ? "bg-success-subtle text-success border-success-subtle" : "bg-light text-muted")">
                        <div class="small fw-semibold mb-1">STEP @(i + 1)</div>
                        <h6 class="fw-bold mb-0">
                            @if (isCompleted && !isCurrent)
                            {
                                <i class="bi bi-check2-circle me-1"></i>
                            }
                            @stepName
                        </h6>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Lead Info & Deal Details -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
                <div class="card-body p-4">
                    <h6 class="fw-bold text-muted text-uppercase small mb-3">
                        <i class="bi bi-person-lines-fill text-primary me-2"></i>Prospect Details
                    </h6>
                    <ul class="list-unstyled mb-0 small">
                        <li class="mb-2">
                            <span class="text-muted d-block">Contact Name:</span>
                            <span class="fw-semibold">@Model.LeadName</span>
                        </li>
                        <li class="mb-2">
                            <span class="text-muted d-block">Email Address:</span>
                            <a href="mailto:@Model.Email" class="text-decoration-none fw-semibold">@Model.Email</a>
                        </li>
                        <li class="mb-2">
                            <span class="text-muted d-block">Mobile Phone:</span>
                            <span class="fw-semibold">@Model.Phone</span>
                        </li>
                        <li>
                            <span class="text-muted d-block">Company / Organization:</span>
                            <span class="fw-semibold">@(Model.CompanyName ?? "—")</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
                <div class="card-body p-4">
                    <h6 class="fw-bold text-muted text-uppercase small mb-3">
                        <i class="bi bi-cash-stack text-success me-2"></i>Commercial Scope
                    </h6>
                    <ul class="list-unstyled mb-0 small">
                        <li class="mb-2">
                            <span class="text-muted d-block">Expected Deal Value:</span>
                            <h4 class="fw-bold text-success mb-0">₹@Model.ExpectedValue.ToString("N2")</h4>
                        </li>
                        <li class="mb-2">
                            <span class="text-muted d-block">Acquisition Source:</span>
                            <span class="badge bg-light text-dark border px-2 py-1">@Model.Source</span>
                        </li>
                        <li>
                            <span class="text-muted d-block">Assigned Account Rep:</span>
                            <span class="fw-semibold">@(Model.AssignedToUser?.FullName ?? "Unassigned")</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
                <div class="card-body p-4">
                    <h6 class="fw-bold text-muted text-uppercase small mb-3">
                        <i class="bi bi-activity text-info me-2"></i>Engagement History
                    </h6>
                    <div class="row g-2 text-center">
                        <div class="col-6">
                            <div class="p-3 border rounded-3 bg-light">
                                <h3 class="fw-bold text-warning mb-0">@Model.Opportunities.Count</h3>
                                <span class="text-muted small">Deals</span>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="p-3 border rounded-3 bg-light">
                                <h3 class="fw-bold text-info mb-0">@Model.FollowUps.Count</h3>
                                <span class="text-muted small">Follow-Ups</span>
                            </div>
                        </div>
                    </div>
                    @if (Model.Status == LeadStatus.Converted && Model.Customer != null)
                    {
                        <div class="mt-3 p-2 bg-primary-subtle text-primary rounded-3 text-center small">
                            <i class="bi bi-check-circle-fill me-1"></i> Converted to Customer:
                            <a asp-controller="Customers" asp-action="Details" asp-route-id="@Model.Customer.CustomerId" class="fw-bold text-decoration-none">
                                @Model.Customer.CustomerName (@Model.Customer.CustomerCode)
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
