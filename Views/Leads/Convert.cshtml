@model AcxiomCRM.ViewModels.LeadConvertViewModel
@using AcxiomCRM.Models.Constants
@{
    ViewData["Title"] = $"Convert Lead - {Model.LeadCode}";
}

<div class="row justify-content-center py-2">
    <div class="col-lg-9">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <div>
                <h3 class="fw-bold mb-1">
                    <i class="bi bi-arrow-repeat text-success me-2"></i>Lead Conversion Wizard
                </h3>
                <p class="text-secondary small mb-0">Transform qualified prospect @Model.LeadCode into an active Customer and Opportunity deal</p>
            </div>
            <a asp-action="Details" asp-route-id="@Model.LeadId" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                <i class="bi bi-arrow-left me-1"></i> Back to Lead
            </a>
        </div>

        <!-- Conversion Pipeline Summary Card -->
        <div class="card border-0 shadow-sm rounded-4 bg-primary text-white mb-4 p-4">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span class="badge bg-white text-primary fw-bold px-2 py-1">@Model.LeadCode</span>
                        <h5 class="fw-bold mb-0 text-white">@Model.LeadName</h5>
                    </div>
                    <p class="small text-white-50 mb-0">
                        <i class="bi bi-envelope me-1"></i>@Model.Email &bull;
                        <i class="bi bi-telephone me-1 ms-2"></i>@Model.Phone &bull;
                        <i class="bi bi-building me-1 ms-2"></i>@(Model.CompanyName ?? "Independent")
                    </p>
                </div>
                <div class="col-md-4 text-md-end mt-3 mt-md-0">
                    <span class="badge bg-success px-3 py-2 rounded-pill fw-semibold fs-6">
                        <i class="bi bi-check-circle-fill me-1"></i> Status: Qualified
                    </span>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm rounded-4 bg-white">
            <div class="card-body p-4 p-md-5">
                <form asp-action="Convert" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="LeadId" />
                    <input type="hidden" asp-for="LeadCode" />
                    <input type="hidden" asp-for="LeadName" />
                    <input type="hidden" asp-for="Email" />
                    <input type="hidden" asp-for="Phone" />
                    <input type="hidden" asp-for="CompanyName" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-4" role="alert"></div>

                    <h5 class="fw-bold text-dark mb-3">
                        <i class="bi bi-currency-dollar text-warning me-2"></i>New Opportunity Details
                    </h5>

                    <div class="mb-3">
                        <label asp-for="OpportunityName" class="form-label fw-semibold small text-secondary"></label>
                        <input asp-for="OpportunityName" class="form-control" autofocus />
                        <span asp-validation-for="OpportunityName" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="DealAmount" class="form-label fw-semibold small text-secondary"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted">₹</span>
                                <input asp-for="DealAmount" class="form-control" type="number" step="1000" />
                            </div>
                            <span asp-validation-for="DealAmount" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ExpectedCloseDate" class="form-label fw-semibold small text-secondary"></label>
                            <input asp-for="ExpectedCloseDate" class="form-control" type="date" />
                            <span asp-validation-for="ExpectedCloseDate" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="Stage" class="form-label fw-semibold small text-secondary"></label>
                            <select asp-for="Stage" class="form-select">
                                <option value="@OpportunityStage.Qualification">Qualification</option>
                                <option value="@OpportunityStage.Proposal" selected>Proposal</option>
                                <option value="@OpportunityStage.Negotiation">Negotiation</option>
                            </select>
                            <span asp-validation-for="Stage" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Probability" class="form-label fw-semibold small text-secondary"></label>
                            <div class="input-group">
                                <input asp-for="Probability" class="form-control" type="number" min="0" max="100" />
                                <span class="input-group-text bg-light text-muted">%</span>
                            </div>
                            <span asp-validation-for="Probability" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Notes" class="form-label fw-semibold small text-secondary"></label>
                        <textarea asp-for="Notes" class="form-control" rows="2" placeholder="Optional notes for account transition..."></textarea>
                        <span asp-validation-for="Notes" class="text-danger small"></span>
                    </div>

                    <div class="alert alert-light border small text-muted mb-4 py-3">
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <i class="bi bi-shield-check text-success fs-5"></i>
                            <strong class="text-dark">Atomic Transaction Guarantee:</strong>
                        </div>
                        Converting this lead creates a new verified <strong>Customer</strong> profile, adds an active <strong>Opportunity</strong> in your sales pipeline, sets lead status to <strong>Converted</strong>, and appends an immutable audit log entry.
                    </div>

                    <div class="d-flex justify-content-end gap-2 pt-2 border-top">
                        <a asp-action="Details" asp-route-id="@Model.LeadId" class="btn btn-light rounded-pill px-4">Cancel</a>
                        <button type="submit" class="btn btn-success rounded-pill px-4 shadow-sm fw-semibold">
                            <i class="bi bi-check2-circle me-1"></i> Complete Conversion
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
