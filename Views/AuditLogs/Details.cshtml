@model AcxiomCRM.ViewModels.AuditLogDetailsViewModel
@using AcxiomCRM.Models.Constants
@{
    ViewData["Title"] = $"Audit Log #{Model.Log.AuditLogId}";
}

<div class="container py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm me-2">
                    <i class="bi bi-arrow-left"></i>
                </a>
                <h3 class="fw-bold mb-0 text-dark">Audit Event #@Model.Log.AuditLogId</h3>
                @switch (Model.Log.Action)
                {
                    case AuditAction.Create:
                        <span class="badge bg-success-subtle text-success fs-6"><i class="bi bi-plus-circle me-1"></i> Create</span>
                        break;
                    case AuditAction.Update:
                        <span class="badge bg-info-subtle text-info fs-6"><i class="bi bi-pencil me-1"></i> Update</span>
                        break;
                    case AuditAction.Delete:
                        <span class="badge bg-danger-subtle text-danger fs-6"><i class="bi bi-trash me-1"></i> Delete</span>
                        break;
                    case AuditAction.Login:
                        <span class="badge bg-primary-subtle text-primary fs-6"><i class="bi bi-box-arrow-in-right me-1"></i> Login</span>
                        break;
                    case AuditAction.FailedLogin:
                        <span class="badge bg-danger-subtle text-danger fs-6"><i class="bi bi-shield-x me-1"></i> Failed Login</span>
                        break;
                    case AuditAction.RoleChange:
                        <span class="badge bg-purple-subtle text-purple fs-6" style="background-color: #ede9fe; color: #6d28d9;"><i class="bi bi-person-gear me-1"></i> Role Change</span>
                        break;
                    case AuditAction.PasswordChange:
                        <span class="badge bg-warning-subtle text-warning fs-6"><i class="bi bi-key me-1"></i> Password Change</span>
                        break;
                    case AuditAction.LeadConversion:
                        <span class="badge bg-warning-subtle text-warning fs-6"><i class="bi bi-arrow-repeat me-1"></i> Lead Converted</span>
                        break;
                    default:
                        <span class="badge bg-secondary-subtle text-secondary fs-6">@Model.Log.Action</span>
                        break;
                }
            </div>
            <p class="text-muted small mb-0">Captured at @Model.Log.CreatedDate.ToString("dddd, dd MMMM yyyy at hh:mm:ss tt") UTC</p>
        </div>

        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Back to Audit Trail
        </a>
    </div>

    <!-- Metadata Card -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-header bg-white border-bottom py-3">
            <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-info-circle text-primary me-2"></i>Event Metadata</h5>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-3">
                    <span class="small text-muted text-uppercase fw-semibold d-block">Entity Name</span>
                    <span class="fw-bold text-dark fs-6">@Model.Log.EntityName</span>
                </div>
                <div class="col-md-3">
                    <span class="small text-muted text-uppercase fw-semibold d-block">Record ID</span>
                    <span class="fw-bold text-dark fs-6 font-monospace">@(Model.Log.RecordId ?? "(None)")</span>
                </div>
                <div class="col-md-3">
                    <span class="small text-muted text-uppercase fw-semibold d-block">Triggered By</span>
                    <span class="fw-bold text-dark fs-6">@(Model.Log.User?.FullName ?? "System Process")</span>
                    @if (Model.Log.User != null)
                    {
                        <div class="small text-muted">@Model.Log.User.Email</div>
                    }
                </div>
                <div class="col-md-3">
                    <span class="small text-muted text-uppercase fw-semibold d-block">IP Address</span>
                    <span class="fw-bold text-dark fs-6 font-monospace">@(Model.Log.IpAddress ?? "127.0.0.1")</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Property Level Diff Table -->
    @if (Model.PropertyDiffs.Any())
    {
        <div class="card border-0 shadow-sm rounded-3 mb-4">
            <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0 text-dark">
                    <i class="bi bi-diagram-3 text-primary me-2"></i>Property-Level Delta Comparison
                </h5>
                <span class="badge bg-light text-secondary border">
                    @Model.PropertyDiffs.Count(d => d.IsChanged) Changed Properties
                </span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr class="small text-muted text-uppercase">
                                <th style="width: 25%;">Property</th>
                                <th style="width: 35%;">Old Value (Before)</th>
                                <th style="width: 35%;">New Value (After)</th>
                                <th style="width: 5%;" class="text-center">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var diff in Model.PropertyDiffs)
                            {
                                <tr class="@(diff.IsChanged ? "table-warning bg-opacity-25" : "")">
                                    <td class="fw-bold font-monospace small">@diff.PropertyName</td>
                                    <td>
                                        <span class="font-monospace small @(diff.IsChanged ? "text-danger text-decoration-line-through" : "text-muted")">
                                            @diff.OldValue
                                        </span>
                                    </td>
                                    <td>
                                        <span class="font-monospace small @(diff.IsChanged ? "text-success fw-bold" : "text-dark")">
                                            @diff.NewValue
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        @if (diff.IsChanged)
                                        {
                                            <span class="badge bg-warning text-dark py-1 px-2" title="Modified"><i class="bi bi-exclamation-circle"></i></span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-muted border py-1 px-2" title="Unchanged"><i class="bi bi-dash"></i></span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    <!-- Side-by-Side Raw Formatted JSON Payloads -->
    <div class="row g-4">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-header bg-white border-bottom py-3">
                    <h6 class="fw-bold mb-0 text-danger">
                        <i class="bi bi-file-earmark-minus me-2"></i>Old Values Payload (JSON)
                    </h6>
                </div>
                <div class="card-body bg-light p-3">
                    @if (string.IsNullOrWhiteSpace(Model.FormattedOldJson))
                    {
                        <p class="text-muted fst-italic small mb-0">No previous state recorded (Initial creation or non-mutating event).</p>
                    }
                    else
                    {
                        <pre class="bg-white p-3 rounded-2 border small font-monospace mb-0" style="max-height: 400px; overflow-y: auto;"><code>@Model.FormattedOldJson</code></pre>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-header bg-white border-bottom py-3">
                    <h6 class="fw-bold mb-0 text-success">
                        <i class="bi bi-file-earmark-plus me-2"></i>New Values Payload (JSON)
                    </h6>
                </div>
                <div class="card-body bg-light p-3">
                    @if (string.IsNullOrWhiteSpace(Model.FormattedNewJson))
                    {
                        <p class="text-muted fst-italic small mb-0">No new state recorded.</p>
                    }
                    else
                    {
                        <pre class="bg-white p-3 rounded-2 border small font-monospace mb-0" style="max-height: 400px; overflow-y: auto;"><code>@Model.FormattedNewJson</code></pre>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
