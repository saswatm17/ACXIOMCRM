@model AcxiomCRM.ViewModels.AuditLogListViewModel
@using AcxiomCRM.Models.Constants
@{
    ViewData["Title"] = "System Audit Trail";
}

<div class="container-fluid px-4 py-3">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="h3 fw-bold mb-1 text-dark">
                <i class="bi bi-shield-check text-primary me-2"></i>System Audit Trail
            </h2>
            <p class="text-muted small mb-0">Immutable record of all business data mutations, user authentications, and security state changes.</p>
        </div>
        <div>
            <span class="badge bg-light text-secondary border px-3 py-2">
                <i class="bi bi-lock me-1"></i> Read-Only Audit Store
            </span>
        </div>
    </div>

    <!-- KPI Metric Cards -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0 bg-primary-subtle text-primary p-3 rounded-3 me-3">
                            <i class="bi bi-journal-check fs-4"></i>
                        </div>
                        <div>
                            <span class="text-muted small text-uppercase fw-semibold">Total Audit Logs</span>
                            <h4 class="fw-bold mb-0 text-dark">@Model.TotalLogsCount</h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0 bg-success-subtle text-success p-3 rounded-3 me-3">
                            <i class="bi bi-plus-circle-dotted fs-4"></i>
                        </div>
                        <div>
                            <span class="text-muted small text-uppercase fw-semibold">Record Creations</span>
                            <h4 class="fw-bold mb-0 text-dark">@Model.CreatesCount</h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0 bg-info-subtle text-info p-3 rounded-3 me-3">
                            <i class="bi bi-pencil-square fs-4"></i>
                        </div>
                        <div>
                            <span class="text-muted small text-uppercase fw-semibold">Record Updates</span>
                            <h4 class="fw-bold mb-0 text-dark">@Model.UpdatesCount</h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0 bg-warning-subtle text-warning p-3 rounded-3 me-3">
                            <i class="bi bi-shield-lock-fill fs-4"></i>
                        </div>
                        <div>
                            <span class="text-muted small text-uppercase fw-semibold">Security Events</span>
                            <h4 class="fw-bold mb-0 text-dark">@Model.SecurityEventsCount</h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filter Form Bar -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-3">
            <form method="get" asp-action="Index" class="row g-2 align-items-end">
                <div class="col-md-2">
                    <label class="form-label small text-muted mb-1">Search Keywords</label>
                    <input type="text" name="search" value="@Model.SearchTerm" class="form-control form-control-sm" placeholder="Record ID, IP, or JSON..." />
                </div>

                <div class="col-md-2">
                    <label class="form-label small text-muted mb-1">Action Type</label>
                    <select name="actionType" asp-items="Model.ActionsList" class="form-select form-select-sm">
                        <option value="">-- All Actions --</option>
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label small text-muted mb-1">Entity Name</label>
                    <select name="entityName" asp-items="Model.EntitiesList" class="form-select form-select-sm">
                        <option value="">-- All Entities --</option>
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label small text-muted mb-1">Staff Member</label>
                    <select name="userId" asp-items="Model.UsersList" class="form-select form-select-sm">
                        <option value="">-- All Staff --</option>
                    </select>
                </div>

                <div class="col-md-3">
                    <label class="form-label small text-muted mb-1">Date Range (From - To)</label>
                    <div class="input-group input-group-sm">
                        <input type="date" name="fromDate" value="@Model.FromDate?.ToString("yyyy-MM-dd")" class="form-control" />
                        <span class="input-group-text bg-white border-start-0 border-end-0">to</span>
                        <input type="date" name="toDate" value="@Model.ToDate?.ToString("yyyy-MM-dd")" class="form-control" />
                    </div>
                </div>

                <div class="col-md-1 text-end">
                    <button type="submit" class="btn btn-sm btn-primary w-100 mb-1"><i class="bi bi-filter"></i> Filter</button>
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary w-100"><i class="bi bi-arrow-counterclockwise"></i> Reset</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Audit Logs Table -->
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr class="small text-muted text-uppercase">
                            <th>Timestamp (UTC)</th>
                            <th>Staff Member</th>
                            <th>Action</th>
                            <th>Entity & Record ID</th>
                            <th>IP Address</th>
                            <th class="text-end">Change Diff</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.AuditLogs.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    <i class="bi bi-shield-slash fs-1 d-block mb-2 text-secondary"></i>
                                    <p class="mb-1 fw-semibold">No audit log records match the selected filter criteria.</p>
                                    <span class="small">Try clearing filters to review the complete audit trail.</span>
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var log in Model.AuditLogs)
                            {
                                <tr>
                                    <td>
                                        <div class="small fw-bold text-dark">
                                            @log.CreatedDate.ToString("dd MMM yyyy")
                                        </div>
                                        <div class="small text-muted">
                                            @log.CreatedDate.ToString("hh:mm:ss tt") UTC
                                        </div>
                                    </td>
                                    <td>
                                        @if (log.User != null)
                                        {
                                            <div class="d-flex align-items-center">
                                                <div class="avatar bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center me-2 fw-bold"
                                                     style="width: 32px; height: 32px; font-size: 0.8rem;">
                                                    @(log.User.FullName.Length > 0 ? log.User.FullName[0].ToString().ToUpper() : "U")
                                                </div>
                                                <div>
                                                    <div class="small fw-bold text-dark">@log.User.FullName</div>
                                                    <div class="text-muted" style="font-size: 0.75rem;">@log.User.Email</div>
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="small text-muted">System / Anonymous</span>
                                        }
                                    </td>
                                    <td>
                                        @switch (log.Action)
                                        {
                                            case AuditAction.Create:
                                                <span class="badge bg-success-subtle text-success"><i class="bi bi-plus-circle me-1"></i> Create</span>
                                                break;
                                            case AuditAction.Update:
                                                <span class="badge bg-info-subtle text-info"><i class="bi bi-pencil me-1"></i> Update</span>
                                                break;
                                            case AuditAction.Delete:
                                                <span class="badge bg-danger-subtle text-danger"><i class="bi bi-trash me-1"></i> Delete</span>
                                                break;
                                            case AuditAction.Login:
                                                <span class="badge bg-primary-subtle text-primary"><i class="bi bi-box-arrow-in-right me-1"></i> Login</span>
                                                break;
                                            case AuditAction.FailedLogin:
                                                <span class="badge bg-danger-subtle text-danger"><i class="bi bi-shield-x me-1"></i> Failed Login</span>
                                                break;
                                            case AuditAction.RoleChange:
                                                <span class="badge bg-purple-subtle text-purple" style="background-color: #ede9fe; color: #6d28d9;"><i class="bi bi-person-gear me-1"></i> Role Change</span>
                                                break;
                                            case AuditAction.PasswordChange:
                                                <span class="badge bg-warning-subtle text-warning"><i class="bi bi-key me-1"></i> Password Change</span>
                                                break;
                                            case AuditAction.LeadConversion:
                                                <span class="badge bg-warning-subtle text-warning"><i class="bi bi-arrow-repeat me-1"></i> Lead Converted</span>
                                                break;
                                            default:
                                                <span class="badge bg-secondary-subtle text-secondary">@log.Action</span>
                                                break;
                                        }
                                    </td>
                                    <td>
                                        <div class="small fw-semibold text-dark">
                                            @log.EntityName
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(log.RecordId))
                                        {
                                            <span class="badge bg-light text-secondary border py-0 px-1 font-monospace" style="font-size: 0.75rem;">
                                                ID: @log.RecordId
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        <span class="small text-muted font-monospace">@(log.IpAddress ?? "127.0.0.1")</span>
                                    </td>
                                    <td class="text-end">
                                        <a asp-action="Details" asp-route-id="@log.AuditLogId" class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-file-earmark-diff me-1"></i> Inspect Diff
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (Model.TotalPages > 1)
        {
            <div class="card-footer bg-white border-0 py-3 d-flex justify-content-between align-items-center">
                <span class="small text-muted">
                    Showing @(((Model.PageNumber - 1) * Model.PageSize) + 1) to @(Math.Min(Model.PageNumber * Model.PageSize, Model.TotalItems)) of @Model.TotalItems log entries
                </span>
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@(Model.PageNumber - 1)"
                               asp-route-actionType="@Model.ActionFilter" asp-route-entityName="@Model.EntityFilter"
                               asp-route-userId="@Model.UserFilter" asp-route-fromDate="@Model.FromDate?.ToString("yyyy-MM-dd")"
                               asp-route-toDate="@Model.ToDate?.ToString("yyyy-MM-dd")" asp-route-search="@Model.SearchTerm">Previous</a>
                        </li>
                        @for (int p = 1; p <= Model.TotalPages; p++)
                        {
                            <li class="page-item @(p == Model.PageNumber ? "active" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@p"
                                   asp-route-actionType="@Model.ActionFilter" asp-route-entityName="@Model.EntityFilter"
                                   asp-route-userId="@Model.UserFilter" asp-route-fromDate="@Model.FromDate?.ToString("yyyy-MM-dd")"
                                   asp-route-toDate="@Model.ToDate?.ToString("yyyy-MM-dd")" asp-route-search="@Model.SearchTerm">@p</a>
                            </li>
                        }
                        <li class="page-item @(Model.PageNumber >= Model.TotalPages ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@(Model.PageNumber + 1)"
                               asp-route-actionType="@Model.ActionFilter" asp-route-entityName="@Model.EntityFilter"
                               asp-route-userId="@Model.UserFilter" asp-route-fromDate="@Model.FromDate?.ToString("yyyy-MM-dd")"
                               asp-route-toDate="@Model.ToDate?.ToString("yyyy-MM-dd")" asp-route-search="@Model.SearchTerm">Next</a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>
