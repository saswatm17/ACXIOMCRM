@model AcxiomCRM.Models.Customer
@{
    ViewData["Title"] = $"{Model.CustomerName} - Details";
}

<div class="container-fluid py-2">
    <!-- Header banner -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 pb-3 mb-4 border-bottom">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1 rounded-pill fw-semibold">
                    @Model.CustomerCode
                </span>
                <h2 class="fw-bold mb-0">@Model.CustomerName</h2>
                @if (Model.Status == "Active")
                {
                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1">Active</span>
                }
                else
                {
                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill px-3 py-1">Inactive</span>
                }
            </div>
            <p class="text-secondary small mb-0">
                <i class="bi bi-building me-1"></i>@(Model.CompanyName ?? "Individual Account") &bull;
                <i class="bi bi-clock me-1 ms-2"></i>Created @Model.CreatedDate.ToString("dd MMM yyyy, hh:mm tt")
                by <strong>@(Model.CreatedByUser?.FullName ?? "System")</strong>
            </p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model.CustomerId" class="btn btn-outline-primary rounded-pill px-3">
                <i class="bi bi-pencil me-1"></i> Edit
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3">
                <i class="bi bi-arrow-left me-1"></i> Back to List
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Top Profile Summary -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
                <div class="card-body p-4">
                    <h6 class="fw-bold text-muted text-uppercase small mb-3">
                        <i class="bi bi-person-lines-fill text-primary me-2"></i>Contact Information
                    </h6>
                    <ul class="list-unstyled mb-0 small">
                        <li class="mb-2">
                            <span class="text-muted d-block">Email Address:</span>
                            <a href="mailto:@Model.Email" class="text-decoration-none fw-semibold">@Model.Email</a>
                        </li>
                        <li class="mb-2">
                            <span class="text-muted d-block">Phone Number:</span>
                            <span class="fw-semibold">@Model.Phone</span>
                        </li>
                        <li>
                            <span class="text-muted d-block">Company Name:</span>
                            <span class="fw-semibold">@(Model.CompanyName ?? "—")</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
                <div class="card-body p-4">
                    <h6 class="fw-bold text-muted text-uppercase small mb-3">
                        <i class="bi bi-geo-alt-fill text-danger me-2"></i>Address & Location
                    </h6>
                    <ul class="list-unstyled mb-0 small">
                        <li class="mb-2">
                            <span class="text-muted d-block">Street Address:</span>
                            <span class="fw-semibold">@(Model.Address ?? "—")</span>
                        </li>
                        <li class="mb-2">
                            <span class="text-muted d-block">City:</span>
                            <span class="fw-semibold">@(Model.City ?? "—")</span>
                        </li>
                        <li>
                            <span class="text-muted d-block">State:</span>
                            <span class="fw-semibold">@(Model.State ?? "—")</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
                <div class="card-body p-4">
                    <h6 class="fw-bold text-muted text-uppercase small mb-3">
                        <i class="bi bi-graph-up-arrow text-success me-2"></i>CRM 360 Overview
                    </h6>
                    <div class="row g-2 text-center">
                        <div class="col-6">
                            <div class="p-2 border rounded-3 bg-light">
                                <h4 class="fw-bold text-primary mb-0">@Model.Leads.Count</h4>
                                <span class="text-muted small">Leads</span>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="p-2 border rounded-3 bg-light">
                                <h4 class="fw-bold text-warning mb-0">@Model.Opportunities.Count</h4>
                                <span class="text-muted small">Opportunities</span>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="p-2 border rounded-3 bg-light">
                                <h4 class="fw-bold text-info mb-0">@Model.FollowUps.Count</h4>
                                <span class="text-muted small">Follow-Ups</span>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="p-2 border rounded-3 bg-light">
                                <h4 class="fw-bold text-secondary mb-0">@Model.Activities.Count</h4>
                                <span class="text-muted small">Activities</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Customer History Tabs -->
    <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden">
        <div class="card-header bg-white border-bottom p-0">
            <ul class="nav nav-tabs card-header-tabs px-3 pt-2" id="customerTab" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="leads-tab" data-bs-toggle="tab" data-bs-target="#leads-pane" type="button" role="tab">
                        <i class="bi bi-funnel me-1 text-success"></i> Related Leads (@Model.Leads.Count)
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="opps-tab" data-bs-toggle="tab" data-bs-target="#opps-pane" type="button" role="tab">
                        <i class="bi bi-currency-dollar me-1 text-warning"></i> Opportunities (@Model.Opportunities.Count)
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="followups-tab" data-bs-toggle="tab" data-bs-target="#followups-pane" type="button" role="tab">
                        <i class="bi bi-calendar-check me-1 text-info"></i> Follow-Ups (@Model.FollowUps.Count)
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="activities-tab" data-bs-toggle="tab" data-bs-target="#activities-pane" type="button" role="tab">
                        <i class="bi bi-list-task me-1 text-secondary"></i> Activities (@Model.Activities.Count)
                    </button>
                </li>
            </ul>
        </div>
        <div class="card-body p-4">
            <div class="tab-content" id="customerTabContent">
                <!-- Leads Pane -->
                <div class="tab-pane fade show active" id="leads-pane" role="tabpanel">
                    @if (Model.Leads.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-sm table-hover align-middle mb-0">
                                <thead class="table-light small">
                                    <tr>
                                        <th>Code</th>
                                        <th>Lead Name</th>
                                        <th>Source</th>
                                        <th>Status</th>
                                        <th>Expected Value</th>
                                        <th>Created Date</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var lead in Model.Leads)
                                    {
                                        <tr>
                                            <td class="fw-semibold text-primary">@lead.LeadCode</td>
                                            <td>@lead.LeadName</td>
                                            <td>@lead.Source</td>
                                            <td><span class="badge bg-light text-dark border">@lead.Status</span></td>
                                            <td>₹@lead.ExpectedValue.ToString("N2")</td>
                                            <td class="small text-muted">@lead.CreatedDate.ToString("dd MMM yyyy")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted small text-center py-4 mb-0">
                            <i class="bi bi-info-circle me-1"></i> No leads linked to this customer yet.
                        </p>
                    }
                </div>

                <!-- Opportunities Pane -->
                <div class="tab-pane fade" id="opps-pane" role="tabpanel">
                    @if (Model.Opportunities.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-sm table-hover align-middle mb-0">
                                <thead class="table-light small">
                                    <tr>
                                        <th>Opportunity</th>
                                        <th>Amount</th>
                                        <th>Stage</th>
                                        <th>Probability</th>
                                        <th>Expected Close</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var opp in Model.Opportunities)
                                    {
                                        <tr>
                                            <td class="fw-semibold">@opp.OpportunityName</td>
                                            <td class="text-success fw-bold">₹@opp.Amount.ToString("N2")</td>
                                            <td><span class="badge bg-primary-subtle text-primary">@opp.Stage</span></td>
                                            <td>@opp.Probability%</td>
                                            <td class="small text-muted">@opp.ExpectedCloseDate.ToString("dd MMM yyyy")</td>
                                            <td><span class="badge bg-light text-dark border">@opp.Status</span></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted small text-center py-4 mb-0">
                            <i class="bi bi-info-circle me-1"></i> No sales opportunities recorded for this customer yet.
                        </p>
                    }
                </div>

                <!-- Follow-Ups Pane -->
                <div class="tab-pane fade" id="followups-pane" role="tabpanel">
                    @if (Model.FollowUps.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-sm table-hover align-middle mb-0">
                                <thead class="table-light small">
                                    <tr>
                                        <th>Date & Time</th>
                                        <th>Type</th>
                                        <th>Remarks</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var fu in Model.FollowUps)
                                    {
                                        <tr>
                                            <td class="small fw-semibold">@fu.FollowUpDate.ToString("dd MMM yyyy, hh:mm tt")</td>
                                            <td>@fu.FollowUpType</td>
                                            <td class="small text-secondary">@(fu.Remarks ?? "—")</td>
                                            <td><span class="badge bg-light text-dark border">@fu.Status</span></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted small text-center py-4 mb-0">
                            <i class="bi bi-info-circle me-1"></i> No follow-ups scheduled for this customer yet.
                        </p>
                    }
                </div>

                <!-- Activities Pane -->
                <div class="tab-pane fade" id="activities-pane" role="tabpanel">
                    @if (Model.Activities.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-sm table-hover align-middle mb-0">
                                <thead class="table-light small">
                                    <tr>
                                        <th>Type</th>
                                        <th>Subject</th>
                                        <th>Date</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var act in Model.Activities)
                                    {
                                        <tr>
                                            <td><span class="badge bg-secondary-subtle text-secondary">@act.ActivityType</span></td>
                                            <td class="fw-semibold">@act.Subject</td>
                                            <td class="small text-muted">@act.ActivityDate.ToString("dd MMM yyyy")</td>
                                            <td><span class="badge bg-light text-dark border">@act.Status</span></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted small text-center py-4 mb-0">
                            <i class="bi bi-info-circle me-1"></i> No activities logged for this customer yet.
                        </p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
