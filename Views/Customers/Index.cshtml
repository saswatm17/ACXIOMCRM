@model AcxiomCRM.ViewModels.CustomerListViewModel
@{
    ViewData["Title"] = "Customer Management";
}

<div class="container-fluid py-2">
    <!-- Breadcrumb & Header -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 pb-3 mb-3 border-bottom">
        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-people-fill text-primary me-2"></i>Customers
            </h2>
            <p class="text-secondary small mb-0">Manage customer accounts, organizations, and communication profiles</p>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-primary rounded-pill px-4 shadow-sm">
                <i class="bi bi-person-plus-fill me-1"></i> Add Customer
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Search & Filter Card -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 bg-white">
        <div class="card-body p-3">
            <form method="get" asp-action="Index" class="row g-2 align-items-center">
                <div class="col-md-5">
                    <div class="input-group">
                        <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-search"></i></span>
                        <input type="text" name="search" value="@Model.SearchTerm" class="form-control border-start-0" placeholder="Search by name, email, phone, company, or city..." />
                    </div>
                </div>
                <div class="col-md-3">
                    <select name="status" class="form-select">
                        <option value="All" selected="@(string.IsNullOrEmpty(Model.SelectedStatus) || Model.SelectedStatus == "All")">All Statuses</option>
                        <option value="Active" selected="@(Model.SelectedStatus == "Active")">Active</option>
                        <option value="Inactive" selected="@(Model.SelectedStatus == "Inactive")">Inactive</option>
                    </select>
                </div>
                <div class="col-md-4 d-flex gap-2">
                    <button type="submit" class="btn btn-primary px-3 rounded-3">
                        <i class="bi bi-funnel me-1"></i> Filter
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary px-3 rounded-3">
                        <i class="bi bi-arrow-counterclockwise me-1"></i> Reset
                    </a>
                    <span class="ms-auto align-self-center text-muted small">
                        Total: <strong>@Model.TotalCount</strong>
                    </span>
                </div>
            </form>
        </div>
    </div>

    <!-- Customers Table Card -->
    <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-secondary small text-uppercase">
                    <tr>
                        <th class="ps-4">Code</th>
                        <th>Customer Name</th>
                        <th>Company</th>
                        <th>Contact</th>
                        <th>Location</th>
                        <th>Status</th>
                        <th>Owner</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Customers.Any())
                    {
                        foreach (var item in Model.Customers)
                        {
                            <tr>
                                <td class="ps-4 fw-semibold text-primary">
                                    @item.CustomerCode
                                </td>
                                <td>
                                    <a asp-action="Details" asp-route-id="@item.CustomerId" class="fw-bold text-dark text-decoration-none">
                                        @item.CustomerName
                                    </a>
                                </td>
                                <td class="text-secondary small">
                                    @(item.CompanyName ?? "—")
                                </td>
                                <td>
                                    <div class="small">
                                        <div><i class="bi bi-envelope me-1 text-muted"></i>@item.Email</div>
                                        <div><i class="bi bi-telephone me-1 text-muted"></i>@item.Phone</div>
                                    </div>
                                </td>
                                <td class="small text-secondary">
                                    @(string.IsNullOrEmpty(item.City) ? "—" : $"{item.City}, {item.State}")
                                </td>
                                <td>
                                    @if (item.Status == "Active")
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2 py-1">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill px-2 py-1">Inactive</span>
                                    }
                                </td>
                                <td class="small text-muted">
                                    @(item.CreatedByUser?.FullName ?? "System")
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@item.CustomerId" class="btn btn-outline-secondary" title="View Details">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.CustomerId" class="btn btn-outline-primary" title="Edit Customer">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        @if (item.Status == "Active")
                                        {
                                            <button type="button" class="btn btn-outline-danger" title="Deactivate"
                                                    data-bs-toggle="modal" data-bs-target="#deactivateModal-@item.CustomerId">
                                                <i class="bi bi-person-x"></i>
                                            </button>
                                        }
                                    </div>

                                    <!-- Deactivation Confirmation Modal -->
                                    <div class="modal fade" id="deactivateModal-@item.CustomerId" tabindex="-1" aria-hidden="true">
                                        <div class="modal-dialog modal-dialog-centered">
                                            <div class="modal-content text-start rounded-4 border-0">
                                                <div class="modal-header border-0 pb-0">
                                                    <h5 class="modal-title fw-bold">Deactivate Customer</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                </div>
                                                <div class="modal-body py-3">
                                                    <p class="text-secondary mb-0">
                                                        Are you sure you want to deactivate customer <strong>@item.CustomerName</strong> (@item.CustomerCode)?
                                                        This will mark their account as Inactive without deleting related historical records.
                                                    </p>
                                                </div>
                                                <div class="modal-footer border-0 pt-0">
                                                    <button type="button" class="btn btn-light rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
                                                    <form asp-action="Deactivate" asp-route-id="@item.CustomerId" method="post" class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-danger rounded-pill px-4">Deactivate</button>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <div class="py-3">
                                    <i class="bi bi-people display-6 d-block mb-2 text-secondary opacity-50"></i>
                                    <h5>No customers found</h5>
                                    <p class="small text-muted mb-3">Try adjusting your search criteria or add a new customer.</p>
                                    <a asp-action="Create" class="btn btn-sm btn-primary rounded-pill px-3">
                                        <i class="bi bi-plus me-1"></i> Add Customer
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination Footer -->
        @if (Model.TotalPages > 1)
        {
            <div class="card-footer bg-white d-flex justify-content-between align-items-center py-3 border-top">
                <span class="text-muted small">
                    Showing page <strong>@Model.CurrentPage</strong> of <strong>@Model.TotalPages</strong>
                </span>
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                            <a class="page-link" asp-action="Index"
                               asp-route-page="@(Model.CurrentPage - 1)"
                               asp-route-search="@Model.SearchTerm"
                               asp-route-status="@Model.SelectedStatus">Previous</a>
                        </li>
                        @for (int p = 1; p <= Model.TotalPages; p++)
                        {
                            <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                                <a class="page-link" asp-action="Index"
                                   asp-route-page="@p"
                                   asp-route-search="@Model.SearchTerm"
                                   asp-route-status="@Model.SelectedStatus">@p</a>
                            </li>
                        }
                        <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                            <a class="page-link" asp-action="Index"
                               asp-route-page="@(Model.CurrentPage + 1)"
                               asp-route-search="@Model.SearchTerm"
                               asp-route-status="@Model.SelectedStatus">Next</a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>
