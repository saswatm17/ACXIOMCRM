@model AcxiomCRM.ViewModels.CustomerFormViewModel
@{
    ViewData["Title"] = "Add Customer";
}

<div class="row justify-content-center py-2">
    <div class="col-lg-8">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <div>
                <h3 class="fw-bold mb-1">
                    <i class="bi bi-person-plus-fill text-primary me-2"></i>Add Customer
                </h3>
                <p class="text-secondary small mb-0">Create a new customer profile in AcxiomCRM</p>
            </div>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                <i class="bi bi-arrow-left me-1"></i> Back to List
            </a>
        </div>

        <div class="card border-0 shadow-sm rounded-4 bg-white">
            <div class="card-body p-4 p-md-5">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-4" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="CustomerName" class="form-label fw-semibold small text-secondary"></label>
                        <input asp-for="CustomerName" class="form-control" placeholder="e.g. Ramesh Patel" autofocus />
                        <span asp-validation-for="CustomerName" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label fw-semibold small text-secondary"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted"><i class="bi bi-envelope"></i></span>
                                <input asp-for="Email" class="form-control" placeholder="ramesh@company.in" />
                            </div>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Phone" class="form-label fw-semibold small text-secondary"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted"><i class="bi bi-telephone"></i></span>
                                <input asp-for="Phone" class="form-control" placeholder="9876543210" maxlength="10" />
                            </div>
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="CompanyName" class="form-label fw-semibold small text-secondary"></label>
                        <input asp-for="CompanyName" class="form-control" placeholder="e.g. TechCorp Solutions Pvt Ltd" />
                        <span asp-validation-for="CompanyName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Address" class="form-label fw-semibold small text-secondary"></label>
                        <input asp-for="Address" class="form-control" placeholder="e.g. Plot 42, Sector 18, Electronics City" />
                        <span asp-validation-for="Address" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="City" class="form-label fw-semibold small text-secondary"></label>
                            <input asp-for="City" class="form-control" placeholder="e.g. Bengaluru" />
                            <span asp-validation-for="City" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="State" class="form-label fw-semibold small text-secondary"></label>
                            <input asp-for="State" class="form-control" placeholder="e.g. Karnataka" />
                            <span asp-validation-for="State" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 pt-2 border-top">
                        <a asp-action="Index" class="btn btn-light rounded-pill px-4">Cancel</a>
                        <button type="submit" class="btn btn-primary rounded-pill px-4 shadow-sm">
                            <i class="bi bi-check2-circle me-1"></i> Save Customer
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
