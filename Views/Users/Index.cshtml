@model AcxiomCRM.ViewModels.UserListViewModel
@using AcxiomCRM.Models.Constants
@{
    ViewData["Title"] = "User & Role Management";
}

<div class="container-fluid px-4 py-3">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="h3 fw-bold mb-1 text-dark">
                <i class="bi bi-people-fill text-danger me-2"></i>User & Role Management
            </h2>
            <p class="text-muted small mb-0">Manage CRM staff accounts, role permissions, account security lockouts, and credentials.</p>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-primary shadow-sm">
                <i class="bi bi-person-plus-fill me-1"></i> Add Staff Member
            </a>
        </div>
    </div>

    <!-- Alert Notifications -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- KPI Metric Cards -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0 bg-primary-subtle text-primary p-3 rounded-3 me-3">
                            <i class="bi bi-people fs-4"></i>
                        </div>
                        <div>
                            <span class="text-muted small text-uppercase fw-semibold">Total Staff</span>
                            <h4 class="fw-bold mb-0 text-dark">@Model.TotalUsers</h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0 bg-success-subtle text-success p-3 rounded-3 me-3">
                            <i class="bi bi-person-check fs-4"></i>
                        </div>
                        <div>
                            <span class="text-muted small text-uppercase fw-semibold">Active Accounts</span>
                            <h4 class="fw-bold mb-0 text-dark">@Model.ActiveUsers</h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0 bg-secondary-subtle text-secondary p-3 rounded-3 me-3">
                            <i class="bi bi-person-x fs-4"></i>
                        </div>
                        <div>
                            <span class="text-muted small text-uppercase fw-semibold">Deactivated</span>
                            <h4 class="fw-bold mb-0 text-dark">@Model.InactiveUsers</h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-3 @(Model.LockedOutUsers > 0 ? "border-start border-danger border-4" : "")">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0 bg-danger-subtle text-danger p-3 rounded-3 me-3">
                            <i class="bi bi-shield-lock fs-4"></i>
                        </div>
                        <div>
                            <span class="text-muted small text-uppercase fw-semibold">Locked Out</span>
                            <h4 class="fw-bold mb-0 text-danger">@Model.LockedOutUsers</h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filters Bar -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-3">
            <form method="get" asp-action="Index" class="row g-2 align-items-center">
                <div class="col-md-4">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
                        <input type="text" name="search" value="@Model.SearchTerm" class="form-control border-start-0" placeholder="Search staff name, email, or phone..." />
                    </div>
                </div>

                <div class="col-md-3">
                    <select name="role" asp-items="Model.RolesList" class="form-select form-select-sm">
                        <option value="">-- All System Roles --</option>
                    </select>
                </div>

                <div class="col-md-3">
                    <select name="status" class="form-select form-select-sm">
                        <option value="">-- All Statuses --</option>
                        <option value="Active" selected="@(Model.StatusFilter == "Active")">Active</option>
                        <option value="Inactive" selected="@(Model.StatusFilter == "Inactive")">Inactive</option>
                        <option value="Locked" selected="@(Model.StatusFilter == "Locked")">Locked Out</option>
                    </select>
                </div>

                <div class="col-auto ms-auto">
                    <button type="submit" class="btn btn-sm btn-outline-primary me-1"><i class="bi bi-filter"></i> Apply</button>
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-counterclockwise"></i> Reset</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Users Table -->
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr class="small text-muted text-uppercase">
                            <th>Staff Member</th>
                            <th>Role</th>
                            <th>Contact Phone</th>
                            <th>Account Status</th>
                            <th>Security / Lockout</th>
                            <th>Joined Date</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Users.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted">
                                    <i class="bi bi-person-x fs-1 d-block mb-2 text-secondary"></i>
                                    <p class="mb-1 fw-semibold">No staff accounts match the filter criteria.</p>
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var u in Model.Users)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="avatar bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-3 fw-bold"
                                                 style="width: 38px; height: 38px; font-size: 0.9rem;">
                                                @(u.FullName.Length > 0 ? u.FullName[0].ToString().ToUpper() : "U")
                                            </div>
                                            <div>
                                                <div class="fw-bold text-dark">@u.FullName</div>
                                                <div class="small text-muted">@u.Email</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        @switch (u.Role)
                                        {
                                            case AppRoles.Admin:
                                                <span class="badge bg-danger-subtle text-danger"><i class="bi bi-shield-fill-check me-1"></i> Admin</span>
                                                break;
                                            case AppRoles.Manager:
                                                <span class="badge bg-primary-subtle text-primary"><i class="bi bi-briefcase-fill me-1"></i> Manager</span>
                                                break;
                                            case AppRoles.SalesExecutive:
                                                <span class="badge bg-success-subtle text-success"><i class="bi bi-person-badge-fill me-1"></i> Sales Executive</span>
                                                break;
                                            default:
                                                <span class="badge bg-secondary">@u.Role</span>
                                                break;
                                        }
                                    </td>
                                    <td>
                                        <span class="small text-dark">@(string.IsNullOrWhiteSpace(u.PhoneNumber) ? "-" : u.PhoneNumber)</span>
                                    </td>
                                    <td>
                                        @if (u.IsActive)
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Deactivated</span>
                                        }
                                    </td>
                                    <td>
                                        @if (u.IsLockedOut)
                                        {
                                            <div class="d-flex align-items-center gap-2">
                                                <span class="badge bg-danger">Locked Out</span>
                                                <form asp-action="Unlock" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@u.Id" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger py-0 px-2" title="Unlock account immediately">
                                                        <i class="bi bi-unlock"></i> Unlock
                                                    </button>
                                                </form>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success-subtle text-success small"><i class="bi bi-check-circle me-1"></i> Normal</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="small text-muted">@u.CreatedDate.ToString("dd MMM yyyy")</span>
                                    </td>
                                    <td class="text-end">
                                        <div class="dropdown">
                                            <button class="btn btn-sm btn-light border dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                                Manage
                                            </button>
                                            <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                                <li>
                                                    <a class="dropdown-item" asp-action="Edit" asp-route-id="@u.Id">
                                                        <i class="bi bi-pencil me-2 text-primary"></i> Edit Profile & Role
                                                    </a>
                                                </li>
                                                <li>
                                                    <a class="dropdown-item" asp-action="ResetPassword" asp-route-id="@u.Id">
                                                        <i class="bi bi-key me-2 text-warning"></i> Reset Password
                                                    </a>
                                                </li>
                                                <li><hr class="dropdown-divider"></li>
                                                <li>
                                                    <form asp-action="ToggleStatus" method="post">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@u.Id" />
                                                        <button type="submit" class="dropdown-item @(u.IsActive ? "text-danger" : "text-success")">
                                                            <i class="bi @(u.IsActive ? "bi-person-x text-danger" : "bi-person-check text-success") me-2"></i>
                                                            @(u.IsActive ? "Deactivate Account" : "Activate Account")
                                                        </button>
                                                    </form>
                                                </li>
                                            </ul>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
