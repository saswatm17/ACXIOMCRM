@model AcxiomCRM.ViewModels.ResetPasswordAdminViewModel
@{
    ViewData["Title"] = "Reset Password";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-xl-5">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-white border-bottom py-3 px-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h4 class="fw-bold mb-1 text-dark">
                                <i class="bi bi-key-fill text-warning me-2"></i>Reset Password
                            </h4>
                            <p class="text-muted small mb-0">Set a new temporary password for this staff member.</p>
                        </div>
                        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                            <i class="bi bi-arrow-left me-1"></i> Back
                        </a>
                    </div>
                </div>

                <div class="card-body p-4">
                    <!-- User Details Summary -->
                    <div class="p-3 bg-light rounded-3 border mb-4">
                        <div class="small text-muted text-uppercase fw-semibold mb-1">Target Account</div>
                        <div class="fw-bold text-dark fs-5 mb-0">@Model.FullName</div>
                        <div class="small text-muted"><i class="bi bi-envelope me-1"></i>@Model.Email</div>
                    </div>

                    <form asp-action="ResetPassword" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="UserId" />
                        <input type="hidden" asp-for="FullName" />
                        <input type="hidden" asp-for="Email" />
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="NewPassword" class="form-label fw-semibold">New Temporary Password <span class="text-danger">*</span></label>
                            <input asp-for="NewPassword" class="form-control" />
                            <span asp-validation-for="NewPassword" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="ConfirmPassword" class="form-label fw-semibold">Confirm Password <span class="text-danger">*</span></label>
                            <input asp-for="ConfirmPassword" class="form-control" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                            <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancel</a>
                            <button type="submit" class="btn btn-warning text-dark px-4 shadow-sm fw-semibold">
                                <i class="bi bi-check2-circle me-1"></i> Update Password
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
