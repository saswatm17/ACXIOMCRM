@using AcxiomCRM.Models.Constants
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AcxiomCRM</title>
    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- Custom Site CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background-color: #f8fafc;
            color: #1e293b;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }
        .navbar-custom {
            background-color: #0f172a;
            border-bottom: 1px solid #1e293b;
        }
        .navbar-brand-badge {
            background: linear-gradient(135deg, #3b82f6, #1d4ed8);
            color: white;
            padding: 4px 10px;
            border-radius: 6px;
            font-weight: 700;
            letter-spacing: 0.5px;
        }
        .nav-link {
            font-size: 0.9rem;
            font-weight: 500;
        }
        .dropdown-menu {
            border-radius: 0.75rem;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
            border: 1px solid #e2e8f0;
        }
        .dropdown-item {
            font-size: 0.875rem;
            padding: 0.5rem 1rem;
        }
        .main-content {
            flex: 1 0 auto;
        }
        .footer-custom {
            background-color: #ffffff;
            border-top: 1px solid #e2e8f0;
            padding: 1rem 0;
            color: #64748b;
            font-size: 0.875rem;
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark navbar-custom shadow-sm">
            <div class="container-fluid px-4">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                    <span class="navbar-brand-badge"><i class="bi bi-briefcase-fill me-1"></i>Acxiom</span>
                    <span class="fw-semibold text-white">CRM</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarSupportedContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 align-items-lg-center">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-controller="Dashboard" asp-action="Index">
                                    <i class="bi bi-speedometer2 me-1 text-primary"></i>Dashboard
                                </a>
                            </li>

                            <!-- Sales CRM Operations (Visible to All Roles) -->
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-light" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-grid-fill me-1 text-info"></i>CRM Modules
                                </a>
                                <ul class="dropdown-menu">
                                    <li>
                                        <a class="dropdown-item" asp-controller="Customers" asp-action="Index">
                                            <i class="bi bi-people me-2 text-primary"></i>Customers
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Leads" asp-action="Index">
                                            <i class="bi bi-funnel me-2 text-success"></i>Leads
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Opportunities" asp-action="Index">
                                            <i class="bi bi-currency-dollar me-2 text-warning"></i>Opportunities
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="FollowUps" asp-action="Index">
                                            <i class="bi bi-calendar-check me-2 text-info"></i>Follow-Ups
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Activities" asp-action="Index">
                                            <i class="bi bi-list-task me-2 text-secondary"></i>Activities
                                        </a>
                                    </li>
                                </ul>
                            </li>

                            <!-- Reports (Visible to Admin and Manager) -->
                            @if (User.IsInRole(AppRoles.Admin) || User.IsInRole(AppRoles.Manager))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-light" asp-controller="Reports" asp-action="Index">
                                        <i class="bi bi-bar-chart-line me-1 text-warning"></i>Reports
                                    </a>
                                </li>
                            }

                            <!-- Admin Only Controls -->
                            @if (User.IsInRole(AppRoles.Admin))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle text-light" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="bi bi-gear-fill me-1 text-danger"></i>Administration
                                    </a>
                                    <ul class="dropdown-menu">
                                        <li>
                                            <a class="dropdown-item" asp-controller="Users" asp-action="Index">
                                                <i class="bi bi-person-gear me-2 text-danger"></i>User & Role Management
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="AuditLogs" asp-action="Index">
                                                <i class="bi bi-journal-text me-2 text-secondary"></i>Audit Logs
                                            </a>
                                        </li>
                                    </ul>
                                </li>
                            }
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-light" asp-controller="Home" asp-action="Index">
                                    <i class="bi bi-house-door me-1"></i>Home
                                </a>
                            </li>
                        }
                    </ul>

                    <ul class="navbar-nav ms-auto align-items-center gap-2">
                        <li class="nav-item">
                            <a class="nav-link text-light opacity-75" href="/swagger" target="_blank" title="OpenAPI Documentation">
                                <i class="bi bi-code-slash me-1"></i>API Docs
                            </a>
                        </li>
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item d-flex align-items-center">
                                <div class="px-2 py-1 bg-dark-subtle rounded-pill border border-secondary border-opacity-25 d-flex align-items-center gap-2">
                                    <span class="text-white small fw-medium">
                                        <i class="bi bi-person-circle me-1 text-light"></i>@User.Identity.Name
                                    </span>
                                    @if (User.IsInRole(AppRoles.Admin))
                                    {
                                        <span class="badge bg-danger rounded-pill px-2">Admin</span>
                                    }
                                    else if (User.IsInRole(AppRoles.Manager))
                                    {
                                        <span class="badge bg-primary rounded-pill px-2">Manager</span>
                                    }
                                    else if (User.IsInRole(AppRoles.SalesExecutive))
                                    {
                                        <span class="badge bg-success rounded-pill px-2">SalesExecutive</span>
                                    }
                                </div>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3">
                                        <i class="bi bi-box-arrow-right me-1"></i>Logout
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn btn-sm btn-outline-light rounded-pill px-3" asp-controller="Account" asp-action="Login">
                                    <i class="bi bi-box-arrow-in-right me-1"></i>Sign In
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-sm btn-primary rounded-pill px-3" asp-controller="Account" asp-action="Register">
                                    <i class="bi bi-person-plus me-1"></i>Register
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="main-content container-fluid px-4 py-4">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="footer-custom mt-auto">
        <div class="container-fluid px-4 d-flex justify-content-between align-items-center">
            <span>&copy; @DateTime.Now.Year - AcxiomCRM | Enterprise Sales & Relationship Management</span>
            <span class="text-muted small">ASP.NET Core .NET 8 &bull; EF Core &bull; SQL Server</span>
        </div>
    </footer>

    <!-- Bootstrap Bundle & jQuery Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
