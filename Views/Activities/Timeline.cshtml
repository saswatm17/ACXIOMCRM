@model IEnumerable<AcxiomCRM.Models.Activity>
@using AcxiomCRM.Models.Constants
@{
    ViewData["Title"] = "Interaction Timeline";
}

<div class="container py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="h3 fw-bold mb-1 text-dark">
                <i class="bi bi-bezier2 text-primary me-2"></i>Interaction Timeline
            </h2>
            <p class="text-muted small mb-0">Chronological history of calls, meetings, emails, and tasks across clients and prospects.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary shadow-sm">
                <i class="bi bi-table me-1"></i> Table View
            </a>
            <a asp-action="Create" class="btn btn-primary shadow-sm">
                <i class="bi bi-plus-circle me-1"></i> Log Activity
            </a>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm rounded-3 py-5 text-center text-muted">
            <i class="bi bi-calendar-x fs-1 d-block mb-3 text-secondary"></i>
            <h5 class="fw-bold mb-1">No timeline activities recorded yet</h5>
            <p class="small mb-3">Log meetings, calls, or tasks to establish customer interaction histories.</p>
            <div>
                <a asp-action="Create" class="btn btn-primary btn-sm"><i class="bi bi-plus-circle me-1"></i> Log First Activity</a>
            </div>
        </div>
    }
    else
    {
        <div class="timeline-container position-relative py-3 ps-4 ps-md-5">
            <!-- Timeline Line -->
            <div class="position-absolute bg-primary-subtle" style="top: 0; bottom: 0; left: 18px; width: 3px;"></div>

            @foreach (var a in Model)
            {
                <div class="timeline-item position-relative mb-4 ps-4">
                    <!-- Timeline Dot / Icon -->
                    <div class="position-absolute rounded-circle shadow-sm d-flex align-items-center justify-content-center text-white"
                         style="left: -32px; top: 0; width: 38px; height: 38px;
                                background-color: @(a.ActivityType == ActivityType.Call ? "#06b6d4" :
                                                    a.ActivityType == ActivityType.Meeting ? "#8b5cf6" :
                                                    a.ActivityType == ActivityType.Email ? "#64748b" : "#3b82f6");">
                        @switch (a.ActivityType)
                        {
                            case ActivityType.Call:
                                <i class="bi bi-telephone-fill small"></i>
                                break;
                            case ActivityType.Meeting:
                                <i class="bi bi-people-fill small"></i>
                                break;
                            case ActivityType.Email:
                                <i class="bi bi-envelope-fill small"></i>
                                break;
                            default:
                                <i class="bi bi-check2-square small"></i>
                                break;
                        }
                    </div>

                    <!-- Timeline Card -->
                    <div class="card border-0 shadow-sm rounded-3">
                        <div class="card-body p-3">
                            <div class="d-flex flex-wrap justify-content-between align-items-center mb-2">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="badge @(a.ActivityType == ActivityType.Call ? "bg-info-subtle text-info" :
                                                         a.ActivityType == ActivityType.Meeting ? "bg-purple-subtle text-purple" :
                                                         a.ActivityType == ActivityType.Email ? "bg-secondary-subtle text-secondary" : "bg-primary-subtle text-primary")"
                                          style="@(a.ActivityType == ActivityType.Meeting ? "background-color: #ede9fe; color: #6d28d9;" : "")">
                                        @a.ActivityType
                                    </span>
                                    <h5 class="fw-bold mb-0 text-dark">
                                        <a asp-action="Details" asp-route-id="@a.ActivityId" class="text-dark text-decoration-none">
                                            @a.Subject
                                        </a>
                                    </h5>
                                </div>
                                <div class="small text-muted">
                                    <i class="bi bi-clock me-1"></i>@a.ActivityDate.ToString("dd MMM yyyy, hh:mm tt")
                                </div>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(a.Description))
                            {
                                <p class="text-secondary small mb-3" style="white-space: pre-line;">@a.Description</p>
                            }

                            <div class="d-flex flex-wrap justify-content-between align-items-center pt-2 border-top">
                                <div>
                                    @if (a.Customer != null)
                                    {
                                        <span class="badge bg-primary-subtle text-primary me-2">Customer</span>
                                        <a asp-controller="Customers" asp-action="Details" asp-route-id="@a.CustomerId" class="fw-semibold text-decoration-none small text-dark">
                                            @a.Customer.CustomerName
                                        </a>
                                    }
                                    else if (a.Lead != null)
                                    {
                                        <span class="badge bg-warning-subtle text-warning me-2">Lead</span>
                                        <a asp-controller="Leads" asp-action="Details" asp-route-id="@a.LeadId" class="fw-semibold text-decoration-none small text-dark">
                                            @a.Lead.LeadName
                                        </a>
                                    }
                                </div>

                                <div class="d-flex align-items-center gap-2">
                                    <span class="small text-muted">
                                        <i class="bi bi-person me-1"></i>@(a.AssignedToUser?.FullName ?? "Unassigned")
                                    </span>
                                    @switch (a.Status)
                                    {
                                        case ActivityStatus.Pending:
                                            <span class="badge bg-warning text-dark small">Pending</span>
                                            break;
                                        case ActivityStatus.Completed:
                                            <span class="badge bg-success small">Completed</span>
                                            break;
                                        case ActivityStatus.Cancelled:
                                            <span class="badge bg-secondary small">Cancelled</span>
                                            break;
                                    }
                                    <a asp-action="Details" asp-route-id="@a.ActivityId" class="btn btn-sm btn-outline-secondary py-0 px-2 small">
                                        Details
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
