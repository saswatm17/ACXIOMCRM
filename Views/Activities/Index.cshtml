@model AcxiomCRM.ViewModels.ActivityListViewModel
@using AcxiomCRM.Models.Constants
@{
    ViewData["Title"] = "Activities Management";
}

<div class="container-fluid px-4 py-3">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="h3 fw-bold mb-1 text-dark">
                <i class="bi bi-clock-history text-primary me-2"></i>Activity Management
            </h2>
            <p class="text-muted small mb-0">Track and log phone calls, customer meetings, email exchanges, and internal sales tasks.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Timeline" class="btn btn-outline-primary shadow-sm">
                <i class="bi bi-bezier2 me-1"></i> Timeline View
            </a>
            <a asp-action="Create" class="btn btn-primary shadow-sm">
                <i class="bi bi-plus-circle me-1"></i> Log Activity
            </a>
        </div>
    </div>

    <!-- Alert Notifications -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- KPI Metric Cards -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-4 col-xl">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0 bg-primary-subtle text-primary p-3 rounded-3 me-3">
                            <i class="bi bi-journal-text fs-4"></i>
                        </div>
                        <div>
                            <span class="text-muted small text-uppercase fw-semibold">Total Logged</span>
                            <h4 class="fw-bold mb-0 text-dark">@Model.TotalActivitiesCount</h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-4 col-xl">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0 bg-warning-subtle text-warning p-3 rounded-3 me-3">
                            <i class="bi bi-hourglass-split fs-4"></i>
                        </div>
                        <div>
                            <span class="text-muted small text-uppercase fw-semibold">Pending</span>
                            <h4 class="fw-bold mb-0 text-dark">@Model.PendingTasksCount</h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-4 col-xl">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0 bg-info-subtle text-info p-3 rounded-3 me-3">
                            <i class="bi bi-telephone-outbound fs-4"></i>
                        </div>
                        <div>
                            <span class="text-muted small text-uppercase fw-semibold">Calls</span>
                            <h4 class="fw-bold mb-0 text-dark">@Model.CallsCount</h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-6 col-xl">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0 bg-purple-subtle text-purple p-3 rounded-3 me-3" style="background-color: #ede9fe; color: #6d28d9;">
                            <i class="bi bi-people fs-4"></i>
                        </div>
                        <div>
                            <span class="text-muted small text-uppercase fw-semibold">Meetings</span>
                            <h4 class="fw-bold mb-0 text-dark">@Model.MeetingsCount</h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-6 col-xl">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0 bg-success-subtle text-success p-3 rounded-3 me-3">
                            <i class="bi bi-check2-circle fs-4"></i>
                        </div>
                        <div>
                            <span class="text-muted small text-uppercase fw-semibold">Completed</span>
                            <h4 class="fw-bold mb-0 text-dark">@Model.CompletedActivitiesCount</h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filters Bar -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-3">
            <form method="get" asp-action="Index" class="row g-2 align-items-center">
                <div class="col-md-3">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
                        <input type="text" name="search" value="@Model.SearchTerm" class="form-control border-start-0" placeholder="Search subject, notes, or client..." />
                    </div>
                </div>

                <div class="col-md-2">
                    <select name="type" asp-items="Model.TypesList" class="form-select form-select-sm">
                        <option value="">-- All Types --</option>
                    </select>
                </div>

                <div class="col-md-2">
                    <select name="status" asp-items="Model.StatusesList" class="form-select form-select-sm">
                        <option value="">-- All Statuses --</option>
                    </select>
                </div>

                @if (User.IsInRole(AppRoles.Admin) || User.IsInRole(AppRoles.Manager))
                {
                    <div class="col-md-3">
                        <select name="assignedTo" asp-items="Model.UsersList" class="form-select form-select-sm">
                            <option value="">-- All Representatives --</option>
                        </select>
                    </div>
                }

                <div class="col-auto ms-auto">
                    <button type="submit" class="btn btn-sm btn-outline-primary me-1"><i class="bi bi-filter"></i> Apply</button>
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-counterclockwise"></i> Reset</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Activities Table -->
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr class="small text-muted text-uppercase">
                            <th>Type</th>
                            <th>Subject</th>
                            <th>Related Contact / Entity</th>
                            <th>Date & Time</th>
                            <th>Status</th>
                            <th>Assigned Staff</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Activities.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted">
                                    <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary"></i>
                                    <p class="mb-1 fw-semibold">No activities match your current filter criteria.</p>
                                    <span class="small">Log a new call, meeting, email, or task to start tracking interactions.</span>
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var a in Model.Activities)
                            {
                                <tr>
                                    <td>
                                        @switch (a.ActivityType)
                                        {
                                            case ActivityType.Call:
                                                <span class="badge bg-info-subtle text-info"><i class="bi bi-telephone-fill me-1"></i> Call</span>
                                                break;
                                            case ActivityType.Meeting:
                                                <span class="badge bg-purple-subtle text-purple" style="background-color: #ede9fe; color: #6d28d9;"><i class="bi bi-people-fill me-1"></i> Meeting</span>
                                                break;
                                            case ActivityType.Email:
                                                <span class="badge bg-secondary-subtle text-secondary"><i class="bi bi-envelope-fill me-1"></i> Email</span>
                                                break;
                                            case ActivityType.Task:
                                                <span class="badge bg-primary-subtle text-primary"><i class="bi bi-check2-square me-1"></i> Task</span>
                                                break;
                                            default:
                                                <span class="badge bg-light text-dark">@a.ActivityType</span>
                                                break;
                                        }
                                    </td>
                                    <td>
                                        <a asp-action="Details" asp-route-id="@a.ActivityId" class="fw-bold text-dark text-decoration-none d-block">
                                            @a.Subject
                                        </a>
                                        <div class="small text-muted text-truncate" style="max-width: 250px;">
                                            @(string.IsNullOrWhiteSpace(a.Description) ? "No notes recorded" : a.Description)
                                        </div>
                                    </td>
                                    <td>
                                        @if (a.Customer != null)
                                        {
                                            <div>
                                                <a asp-controller="Customers" asp-action="Details" asp-route-id="@a.CustomerId" class="fw-semibold text-decoration-none text-dark">
                                                    @a.Customer.CustomerName
                                                </a>
                                                <div class="small text-muted">
                                                    <span class="badge bg-primary-subtle text-primary py-0 px-1">Customer</span> @(a.Customer.CompanyName ?? a.Customer.City)
                                                </div>
                                            </div>
                                        }
                                        else if (a.Lead != null)
                                        {
                                            <div>
                                                <a asp-controller="Leads" asp-action="Details" asp-route-id="@a.LeadId" class="fw-semibold text-decoration-none text-dark">
                                                    @a.Lead.LeadName
                                                </a>
                                                <div class="small text-muted">
                                                    <span class="badge bg-warning-subtle text-warning py-0 px-1">Lead</span> @(a.Lead.CompanyName ?? a.Lead.Source)
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">General Activity</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="small fw-semibold text-dark">
                                            <i class="bi bi-calendar3 me-1 text-muted"></i>@a.ActivityDate.ToString("dd MMM yyyy, hh:mm tt")
                                        </span>
                                    </td>
                                    <td>
                                        @switch (a.Status)
                                        {
                                            case ActivityStatus.Pending:
                                                <span class="badge bg-warning text-dark">Pending</span>
                                                break;
                                            case ActivityStatus.Completed:
                                                <span class="badge bg-success">Completed</span>
                                                break;
                                            case ActivityStatus.Cancelled:
                                                <span class="badge bg-secondary">Cancelled</span>
                                                break;
                                            default:
                                                <span class="badge bg-light text-dark">@a.Status</span>
                                                break;
                                        }
                                    </td>
                                    <td>
                                        <span class="small fw-semibold text-dark">@(a.AssignedToUser?.FullName ?? "Unassigned")</span>
                                    </td>
                                    <td class="text-end">
                                        <div class="d-flex justify-content-end gap-1">
                                            @if (a.Status == ActivityStatus.Pending)
                                            {
                                                <button class="btn btn-sm btn-outline-success" data-bs-toggle="modal" data-bs-target="#completeModal-@a.ActivityId" title="Mark Completed">
                                                    <i class="bi bi-check-lg"></i>
                                                </button>
                                            }
                                            <a asp-action="Details" asp-route-id="@a.ActivityId" class="btn btn-sm btn-outline-secondary" title="View Details">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@a.ActivityId" class="btn btn-sm btn-outline-primary" title="Edit">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                        </div>

                                        <!-- Complete Modal -->
                                        @if (a.Status == ActivityStatus.Pending)
                                        {
                                            <div class="modal fade" id="completeModal-@a.ActivityId" tabindex="-1">
                                                <div class="modal-dialog modal-dialog-centered">
                                                    <div class="modal-content text-start">
                                                        <form asp-action="Complete" method="post">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="id" value="@a.ActivityId" />
                                                            <div class="modal-header">
                                                                <h5 class="modal-title fw-bold text-success"><i class="bi bi-check-circle me-2"></i> Complete Activity</h5>
                                                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                            </div>
                                                            <div class="modal-body">
                                                                <p class="small text-muted mb-2">Record final outcomes, meeting minutes, or action summary:</p>
                                                                <textarea name="completionNote" class="form-control" rows="3" placeholder="Enter outcome notes..."></textarea>
                                                            </div>
                                                            <div class="modal-footer">
                                                                <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                                <button type="submit" class="btn btn-sm btn-success">Mark Completed</button>
                                                            </div>
                                                        </form>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (Model.TotalPages > 1)
        {
            <div class="card-footer bg-white border-0 py-3">
                <nav>
                    <ul class="pagination pagination-sm justify-content-end mb-0">
                        <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@(Model.PageNumber - 1)" asp-route-type="@Model.TypeFilter" asp-route-status="@Model.StatusFilter" asp-route-assignedTo="@Model.AssignedToFilter" asp-route-search="@Model.SearchTerm">Previous</a>
                        </li>
                        @for (int p = 1; p <= Model.TotalPages; p++)
                        {
                            <li class="page-item @(p == Model.PageNumber ? "active" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-type="@Model.TypeFilter" asp-route-status="@Model.StatusFilter" asp-route-assignedTo="@Model.AssignedToFilter" asp-route-search="@Model.SearchTerm">@p</a>
                            </li>
                        }
                        <li class="page-item @(Model.PageNumber >= Model.TotalPages ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@(Model.PageNumber + 1)" asp-route-type="@Model.TypeFilter" asp-route-status="@Model.StatusFilter" asp-route-assignedTo="@Model.AssignedToFilter" asp-route-search="@Model.SearchTerm">Next</a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>
