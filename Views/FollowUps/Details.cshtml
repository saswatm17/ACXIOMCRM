@model AcxiomCRM.Models.FollowUp
@using AcxiomCRM.Models.Constants
@{
    ViewData["Title"] = $"Follow-Up #{Model.FollowUpId}";
    var isOverdue = (Model.Status == FollowUpStatus.Planned && Model.FollowUpDate < DateTime.UtcNow) || Model.Status == FollowUpStatus.Missed;
}

<div class="container py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm me-2">
                    <i class="bi bi-arrow-left"></i>
                </a>
                <h3 class="fw-bold mb-0 text-dark">Follow-Up #@Model.FollowUpId</h3>
                @switch (Model.Status)
                {
                    case FollowUpStatus.Planned:
                        <span class="badge bg-primary fs-6">Scheduled</span>
                        break;
                    case FollowUpStatus.Completed:
                        <span class="badge bg-success fs-6">Completed</span>
                        break;
                    case FollowUpStatus.Missed:
                        <span class="badge bg-danger fs-6">Missed / Overdue</span>
                        break;
                    case FollowUpStatus.Cancelled:
                        <span class="badge bg-secondary fs-6">Cancelled</span>
                        break;
                    default:
                        <span class="badge bg-light text-dark fs-6">@Model.Status</span>
                        break;
                }
                @if (isOverdue && Model.Status != FollowUpStatus.Missed)
                {
                    <span class="badge bg-danger text-white fs-6">Overdue</span>
                }
            </div>
            <p class="text-muted small mb-0">Scheduled for @Model.FollowUpDate.ToString("dddd, dd MMMM yyyy at hh:mm tt")</p>
        </div>

        <div class="d-flex gap-2">
            @if (Model.Status == FollowUpStatus.Planned || Model.Status == FollowUpStatus.Missed)
            {
                <button type="button" class="btn btn-success shadow-sm" data-bs-toggle="modal" data-bs-target="#completeModal">
                    <i class="bi bi-check-circle me-1"></i> Mark Completed
                </button>
                <button type="button" class="btn btn-warning text-dark shadow-sm" data-bs-toggle="modal" data-bs-target="#rescheduleModal">
                    <i class="bi bi-clock-history me-1"></i> Reschedule
                </button>
                <a asp-action="Edit" asp-route-id="@Model.FollowUpId" class="btn btn-outline-primary">
                    <i class="bi bi-pencil me-1"></i> Edit
                </a>
                <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#cancelModal">
                    <i class="bi bi-x-circle me-1"></i> Cancel
                </button>
            }
            else
            {
                <a asp-action="Edit" asp-route-id="@Model.FollowUpId" class="btn btn-outline-primary">
                    <i class="bi bi-pencil me-1"></i> Edit Details
                </a>
            }
        </div>
    </div>

    <!-- Alert Notifications -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-4">
        <!-- Follow-Up Details -->
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-3 mb-4">
                <div class="card-header bg-white border-bottom py-3">
                    <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-info-circle text-primary me-2"></i>Interaction Details</h5>
                </div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-4 text-muted">Interaction Type:</dt>
                        <dd class="col-sm-8 fw-semibold">
                            @switch (Model.FollowUpType)
                            {
                                case FollowUpType.Call:
                                    <span class="badge bg-info-subtle text-info"><i class="bi bi-telephone-fill me-1"></i> Phone Call</span>
                                    break;
                                case FollowUpType.Meeting:
                                    <span class="badge bg-primary-subtle text-primary"><i class="bi bi-people-fill me-1"></i> In-Person / Online Meeting</span>
                                    break;
                                case FollowUpType.Email:
                                    <span class="badge bg-secondary-subtle text-secondary"><i class="bi bi-envelope-fill me-1"></i> Email Communication</span>
                                    break;
                                case FollowUpType.ProductDemo:
                                    <span class="badge bg-purple-subtle text-purple" style="background-color: #ede9fe; color: #6d28d9;"><i class="bi bi-laptop me-1"></i> Product Demonstration</span>
                                    break;
                                default:
                                    <span>@Model.FollowUpType</span>
                                    break;
                            }
                        </dd>

                        <dt class="col-sm-4 text-muted">Scheduled For:</dt>
                        <dd class="col-sm-8 fw-semibold @(isOverdue ? "text-danger" : "text-dark")">
                            <i class="bi bi-calendar3 me-1"></i> @Model.FollowUpDate.ToString("dd MMMM yyyy, hh:mm tt")
                        </dd>

                        <dt class="col-sm-4 text-muted">Assigned Staff:</dt>
                        <dd class="col-sm-8 fw-semibold">
                            @(Model.AssignedToUser?.FullName ?? "Unassigned")
                            @if (!string.IsNullOrEmpty(Model.AssignedToUser?.Email))
                            {
                                <span class="small text-muted">(@Model.AssignedToUser.Email)</span>
                            }
                        </dd>

                        <dt class="col-sm-4 text-muted">Scheduled On:</dt>
                        <dd class="col-sm-8 text-dark">
                            @Model.CreatedDate.ToString("dd MMM yyyy, hh:mm tt")
                        </dd>
                    </dl>
                </div>
            </div>

            <!-- Notes & History Card -->
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-white border-bottom py-3">
                    <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-journal-text text-primary me-2"></i>Agenda & Notes History</h5>
                </div>
                <div class="card-body">
                    @if (string.IsNullOrWhiteSpace(Model.Remarks))
                    {
                        <p class="text-muted fst-italic mb-0">No notes or agenda recorded for this follow-up.</p>
                    }
                    else
                    {
                        <div class="p-3 bg-light rounded-3 border" style="white-space: pre-line; line-height: 1.6;">
                            @Model.Remarks
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Related Account / Prospect Card -->
        <div class="col-lg-5">
            @if (Model.Customer != null)
            {
                <div class="card border-0 shadow-sm rounded-3 mb-4">
                    <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                        <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-building text-primary me-2"></i>Customer Account</h5>
                        <span class="badge bg-primary-subtle text-primary">@Model.Customer.CustomerCode</span>
                    </div>
                    <div class="card-body">
                        <h5 class="fw-bold text-dark mb-1">@Model.Customer.CustomerName</h5>
                        <p class="text-muted small mb-3">@(Model.Customer.CompanyName ?? Model.Customer.City)</p>

                        <ul class="list-unstyled small mb-3">
                            <li class="mb-2"><i class="bi bi-envelope text-muted me-2"></i> <a href="mailto:@Model.Customer.Email" class="text-decoration-none">@Model.Customer.Email</a></li>
                            <li class="mb-2"><i class="bi bi-telephone text-muted me-2"></i> <a href="tel:@Model.Customer.Phone" class="text-decoration-none">@Model.Customer.Phone</a></li>
                            <li class="mb-2"><i class="bi bi-geo-alt text-muted me-2"></i> @Model.Customer.City, @Model.Customer.State</li>
                        </ul>

                        <a asp-controller="Customers" asp-action="Details" asp-route-id="@Model.Customer.CustomerId" class="btn btn-outline-primary btn-sm w-100">
                            <i class="bi bi-box-arrow-up-right me-1"></i> View 360° Customer Profile
                        </a>
                    </div>
                </div>
            }

            @if (Model.Lead != null)
            {
                <div class="card border-0 shadow-sm rounded-3 mb-4">
                    <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                        <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-person-lines-fill text-warning me-2"></i>Lead Prospect</h5>
                        <span class="badge bg-warning-subtle text-warning">@Model.Lead.LeadCode</span>
                    </div>
                    <div class="card-body">
                        <h5 class="fw-bold text-dark mb-1">@Model.Lead.LeadName</h5>
                        <p class="text-muted small mb-3">@(Model.Lead.CompanyName ?? Model.Lead.Source)</p>

                        <ul class="list-unstyled small mb-3">
                            <li class="mb-2"><i class="bi bi-envelope text-muted me-2"></i> <a href="mailto:@Model.Lead.Email" class="text-decoration-none">@Model.Lead.Email</a></li>
                            <li class="mb-2"><i class="bi bi-telephone text-muted me-2"></i> <a href="tel:@Model.Lead.Phone" class="text-decoration-none">@Model.Lead.Phone</a></li>
                            <li class="mb-2"><i class="bi bi-cash-stack text-muted me-2"></i> Expected: ₹@Model.Lead.ExpectedValue.ToString("N0")</li>
                        </ul>

                        <a asp-controller="Leads" asp-action="Details" asp-route-id="@Model.Lead.LeadId" class="btn btn-outline-warning text-dark btn-sm w-100">
                            <i class="bi bi-box-arrow-up-right me-1"></i> View Lead Details & History
                        </a>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- Modal: Complete -->
<div class="modal fade" id="completeModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form asp-action="Complete" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.FollowUpId" />
                <input type="hidden" name="returnUrl" value="@Url.Action("Details", new { id = Model.FollowUpId })" />
                <div class="modal-header">
                    <h5 class="modal-title fw-bold text-success"><i class="bi bi-check-circle me-2"></i> Mark Completed</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p class="small text-muted mb-2">Record outcome notes, client response, and any follow-up actions:</p>
                    <textarea name="remarks" class="form-control" rows="4" placeholder="Enter notes from the call/meeting..."></textarea>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-sm btn-success">Mark as Completed</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Reschedule -->
<div class="modal fade" id="rescheduleModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form asp-action="Reschedule" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.FollowUpId" />
                <input type="hidden" name="returnUrl" value="@Url.Action("Details", new { id = Model.FollowUpId })" />
                <div class="modal-header">
                    <h5 class="modal-title fw-bold text-warning text-dark"><i class="bi bi-clock-history me-2"></i> Reschedule Follow-Up</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">New Scheduled Date & Time <span class="text-danger">*</span></label>
                        <input type="datetime-local" name="newDate" class="form-control" required
                               value="@DateTime.UtcNow.AddDays(1).ToString("yyyy-MM-ddTHH:mm")"
                               min="@DateTime.UtcNow.ToString("yyyy-MM-ddTHH:mm")" />
                        <span class="form-text small text-muted">Follow-up date cannot be earlier than today.</span>
                    </div>
                    <div class="mb-2">
                        <label class="form-label small fw-semibold">Reason for Rescheduling</label>
                        <textarea name="remarks" class="form-control" rows="3" placeholder="Client was busy, requested callback..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-sm btn-primary">Save New Schedule</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Cancel -->
<div class="modal fade" id="cancelModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form asp-action="Cancel" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.FollowUpId" />
                <input type="hidden" name="returnUrl" value="@Url.Action("Details", new { id = Model.FollowUpId })" />
                <div class="modal-header">
                    <h5 class="modal-title fw-bold text-danger"><i class="bi bi-x-circle me-2"></i> Cancel Follow-Up</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p class="small text-muted mb-2">Are you sure you want to cancel this scheduled follow-up?</p>
                    <textarea name="remarks" class="form-control" rows="3" placeholder="Provide reason for cancelling..."></textarea>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Back</button>
                    <button type="submit" class="btn btn-sm btn-danger">Confirm Cancellation</button>
                </div>
            </form>
        </div>
    </div>
</div>
