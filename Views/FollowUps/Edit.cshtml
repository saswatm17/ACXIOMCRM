@model AcxiomCRM.ViewModels.FollowUpFormViewModel
@using AcxiomCRM.Models.Constants
@{
    ViewData["Title"] = "Edit Follow-Up";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-9 col-xl-8">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-white border-bottom py-3 px-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h4 class="fw-bold mb-1 text-dark">
                                <i class="bi bi-pencil-square text-primary me-2"></i>Edit Follow-Up
                            </h4>
                            <p class="text-muted small mb-0">Modify interaction schedule, type, assigned representative, or status.</p>
                        </div>
                        <a asp-action="Details" asp-route-id="@Model.FollowUpId" class="btn btn-outline-secondary btn-sm">
                            <i class="bi bi-arrow-left me-1"></i> Back to Details
                        </a>
                    </div>
                </div>

                <div class="card-body p-4">
                    <form asp-action="Edit" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="FollowUpId" />
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3" role="alert"></div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="CustomerId" class="form-label fw-semibold">Customer Account</label>
                                <select asp-for="CustomerId" asp-items="Model.CustomersList" class="form-select">
                                    <option value="">-- No Customer Link --</option>
                                </select>
                                <span asp-validation-for="CustomerId" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="LeadId" class="form-label fw-semibold">Lead Prospect</label>
                                <select asp-for="LeadId" asp-items="Model.LeadsList" class="form-select">
                                    <option value="">-- No Lead Link --</option>
                                </select>
                                <span asp-validation-for="LeadId" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="FollowUpType" class="form-label fw-semibold">Interaction Type <span class="text-danger">*</span></label>
                                <select asp-for="FollowUpType" asp-items="Model.TypesList" class="form-select"></select>
                                <span asp-validation-for="FollowUpType" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="FollowUpDate" class="form-label fw-semibold">Scheduled Date & Time <span class="text-danger">*</span></label>
                                <input asp-for="FollowUpDate" type="datetime-local" class="form-control"
                                       value="@Model.FollowUpDate.ToString("yyyy-MM-ddTHH:mm")" />
                                <span asp-validation-for="FollowUpDate" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="Status" class="form-label fw-semibold">Current Status <span class="text-danger">*</span></label>
                                <select asp-for="Status" class="form-select">
                                    @foreach (var s in FollowUpStatus.All)
                                    {
                                        <option value="@s" selected="@(Model.Status == s)">@s</option>
                                    }
                                </select>
                                <span asp-validation-for="Status" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="AssignedTo" class="form-label fw-semibold">Assigned Team Member</label>
                                <select asp-for="AssignedTo" asp-items="Model.UsersList" class="form-select">
                                    <option value="">-- Unassigned --</option>
                                </select>
                                <span asp-validation-for="AssignedTo" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Remarks" class="form-label fw-semibold">Notes / Conversation History</label>
                            <textarea asp-for="Remarks" class="form-control" rows="4" placeholder="Enter notes or updates..."></textarea>
                            <span asp-validation-for="Remarks" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                            <a asp-action="Details" asp-route-id="@Model.FollowUpId" class="btn btn-outline-secondary px-4">Cancel</a>
                            <button type="submit" class="btn btn-primary px-4 shadow-sm">
                                <i class="bi bi-save me-1"></i> Update Changes
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
