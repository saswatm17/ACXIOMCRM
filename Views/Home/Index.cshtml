@{
    ViewData["Title"] = "Welcome";
}

<div class="row justify-content-center mt-4">
    <div class="col-lg-10">
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
            <div class="card-body p-5 bg-white">
                <div class="d-flex align-items-center mb-3">
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 rounded-pill fw-semibold">
                        <i class="bi bi-shield-check me-1"></i> Final Year Project &bull; B.Tech CSE/IT
                    </span>
                    <span class="ms-auto text-muted small">
                        <i class="bi bi-clock me-1"></i> .NET 8 &bull; EF Core
                    </span>
                </div>

                <h1 class="display-5 fw-bold text-dark mb-3">
                    Acxiom<span class="text-primary">CRM</span>
                </h1>
                <p class="lead text-secondary mb-4">
                    Enterprise Role-Based Customer Relationship Management Web Application built with ASP.NET Core MVC, Entity Framework Core Code-First, and ASP.NET Core Identity.
                </p>

                <div class="row g-4 my-2">
                    <div class="col-md-4">
                        <div class="p-3 border rounded-3 bg-light h-100">
                            <h6 class="fw-bold text-dark mb-2"><i class="bi bi-people-fill text-primary me-2"></i>Role Architecture</h6>
                            <p class="text-muted small mb-0">Role-scoped access for Admin, Sales Manager, and Sales Executives with server-side authorization checks.</p>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3 border rounded-3 bg-light h-100">
                            <h6 class="fw-bold text-dark mb-2"><i class="bi bi-funnel-fill text-success me-2"></i>Sales Pipeline</h6>
                            <p class="text-muted small mb-0">End-to-end tracking of Leads, Opportunities, Activities, and Follow-ups with strict validation rules.</p>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3 border rounded-3 bg-light h-100">
                            <h6 class="fw-bold text-dark mb-2"><i class="bi bi-code-square text-info me-2"></i>REST APIs & Swagger</h6>
                            <p class="text-muted small mb-0">DTO-based secured endpoints for CRM integration with interactive OpenAPI / Swagger UI documentation.</p>
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-3 mt-4 pt-2">
                    <a href="/swagger" target="_blank" class="btn btn-outline-primary px-4 py-2 rounded-pill">
                        <i class="bi bi-file-earmark-code me-1"></i> View Swagger API Docs
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
