@{
    int statusCode = ViewBag.StatusCode != null ? (int)ViewBag.StatusCode : 404;
    ViewData["Title"] = $"Error {statusCode}";

    string title = statusCode switch
    {
        404 => "Page Not Found",
        403 => "Access Forbidden",
        500 => "Internal Server Error",
        _ => "An Error Occurred"
    };

    string description = statusCode switch
    {
        404 => "The page or record you are looking for does not exist or may have been moved.",
        403 => "You do not have the required permissions or role scope to view this page.",
        500 => "Our server encountered an unexpected situation. Please try again or notify technical support.",
        _ => "Something went wrong while processing your request."
    };

    string icon = statusCode switch
    {
        404 => "bi-search",
        403 => "bi-shield-lock-fill",
        500 => "bi-exclamation-octagon-fill",
        _ => "bi-exclamation-triangle-fill"
    };

    string badgeColor = statusCode switch
    {
        404 => "bg-warning-subtle text-warning-emphasis border-warning-subtle",
        403 => "bg-danger-subtle text-danger-emphasis border-danger-subtle",
        _ => "bg-secondary-subtle text-secondary-emphasis border-secondary-subtle"
    };
}

<div class="row justify-content-center align-items-center" style="min-height: 65vh;">
    <div class="col-md-7 col-lg-5 text-center">
        <div class="card border-0 shadow-sm rounded-4 p-5 bg-white">
            <div class="d-inline-flex align-items-center justify-content-center border rounded-circle mb-3 mx-auto @badgeColor" style="width: 80px; height: 80px;">
                <i class="bi @icon fs-1"></i>
            </div>
            <h1 class="display-4 fw-bold text-dark mb-1">@statusCode</h1>
            <h4 class="fw-semibold text-secondary mb-3">@title</h4>
            <p class="text-muted small mb-4">
                @description
            </p>
            <div class="d-flex justify-content-center gap-2">
                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary rounded-pill px-4">
                        <i class="bi bi-speedometer2 me-1"></i> Back to Dashboard
                    </a>
                }
                else
                {
                    <a asp-controller="Home" asp-action="Index" class="btn btn-primary rounded-pill px-4">
                        <i class="bi bi-house me-1"></i> Go to Home
                    </a>
                }
                <button type="button" onclick="history.back()" class="btn btn-outline-secondary rounded-pill px-4">
                    <i class="bi bi-arrow-left me-1"></i> Go Back
                </button>
            </div>
        </div>
    </div>
</div>
