@model AcxiomCRM.ViewModels.OpportunityFormViewModel
@using AcxiomCRM.Models.Constants
@{
    ViewData["Title"] = "Edit Opportunity";
}

<div class="row justify-content-center py-2">
    <div class="col-lg-8">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <div>
                <h3 class="fw-bold mb-1">
                    <i class="bi bi-pencil-square text-primary me-2"></i>Edit Opportunity
                </h3>
                <p class="text-secondary small mb-0">Update deal status, stage progression, and probability</p>
            </div>
            <a asp-action="Details" asp-route-id="@Model.OpportunityId" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                <i class="bi bi-arrow-left me-1"></i> Back to Details
            </a>
        </div>

        <div class="card border-0 shadow-sm rounded-4 bg-white">
            <div class="card-body p-4 p-md-5">
                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="OpportunityId" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-4" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="OpportunityName" class="form-label fw-semibold small text-secondary"></label>
                        <input asp-for="OpportunityName" class="form-control" autofocus />
                        <span asp-validation-for="OpportunityName" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="CustomerId" class="form-label fw-semibold small text-secondary"></label>
                            <select asp-for="CustomerId" asp-items="Model.CustomersList" class="form-select">
                                <option value="">-- Select Customer Organization --</option>
                            </select>
                            <span asp-validation-for="CustomerId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="LeadId" class="form-label fw-semibold small text-secondary"></label>
                            <select asp-for="LeadId" asp-items="Model.LeadsList" class="form-select">
                                <option value="">-- Select Originating Lead (Optional) --</option>
                            </select>
                            <span asp-validation-for="LeadId" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Amount" class="form-label fw-semibold small text-secondary"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted">₹</span>
                                <input asp-for="Amount" class="form-control" type="number" step="1000" />
                            </div>
                            <span asp-validation-for="Amount" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ExpectedCloseDate" class="form-label fw-semibold small text-secondary"></label>
                            <input asp-for="ExpectedCloseDate" class="form-control" type="date" />
                            <span asp-validation-for="ExpectedCloseDate" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-4">
                            <label asp-for="Stage" class="form-label fw-semibold small text-secondary"></label>
                            <select asp-for="Stage" class="form-select" id="stageSelect" onchange="onStageChanged()">
                                @foreach (var stg in OpportunityStage.All)
                                {
                                    <option value="@stg" selected="@(Model.Stage == stg)">@stg</option>
                                }
                            </select>
                            <span asp-validation-for="Stage" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Probability" class="form-label fw-semibold small text-secondary"></label>
                            <div class="input-group">
                                <input asp-for="Probability" class="form-control" type="number" min="0" max="100" id="probabilityInput" />
                                <span class="input-group-text bg-light text-muted">%</span>
                            </div>
                            <span asp-validation-for="Probability" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="AssignedTo" class="form-label fw-semibold small text-secondary"></label>
                            <select asp-for="AssignedTo" asp-items="Model.UsersList" class="form-select"></select>
                            <span asp-validation-for="AssignedTo" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 pt-2 border-top">
                        <a asp-action="Details" asp-route-id="@Model.OpportunityId" class="btn btn-light rounded-pill px-4">Cancel</a>
                        <button type="submit" class="btn btn-primary rounded-pill px-4 shadow-sm">
                            <i class="bi bi-check2-circle me-1"></i> Update Opportunity
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function onStageChanged() {
            var stage = document.getElementById('stageSelect').value;
            var prob = document.getElementById('probabilityInput');
            if (stage === 'Won') {
                prob.value = 100;
            } else if (stage === 'Lost') {
                prob.value = 0;
            }
        }
    </script>
}
