@model AcxiomCRM.ViewModels.OpportunityListViewModel
@using AcxiomCRM.Models.Constants
@{
    ViewData["Title"] = "Opportunity Pipeline";
}

<div class="container-fluid py-2">
    <!-- Breadcrumb & Header -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 pb-3 mb-3 border-bottom">
        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-currency-dollar text-warning me-2"></i>Opportunities & Pipeline
            </h2>
            <p class="text-secondary small mb-0">Track active commercial deals, stage probabilities, and weighted sales forecasts</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Pipeline" class="btn btn-outline-primary rounded-pill px-3">
                <i class="bi bi-kanban me-1"></i> Pipeline Board
            </a>
            <a asp-action="Create" class="btn btn-primary rounded-pill px-4 shadow-sm">
                <i class="bi bi-plus-circle-fill me-1"></i> New Opportunity
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- KPI Metric Cards -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 bg-white p-3">
                <div class="d-flex align-items-center justify-content-between mb-1">
                    <span class="text-muted small fw-semibold text-uppercase">Total Pipeline</span>
                    <i class="bi bi-funnel-fill text-primary fs-5"></i>
                </div>
                <h3 class="fw-bold text-dark mb-0">₹@Model.TotalPipelineValue.ToString("N0")</h3>
                <span class="text-muted small">@Model.OpenDealsCount active open deals</span>
            </div>
        </div>

        <div class="col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 bg-white p-3">
                <div class="d-flex align-items-center justify-content-between mb-1">
                    <span class="text-muted small fw-semibold text-uppercase">Weighted Forecast</span>
                    <i class="bi bi-pie-chart-fill text-info fs-5"></i>
                </div>
                <h3 class="fw-bold text-info mb-0">₹@Model.TotalWeightedValue.ToString("N0")</h3>
                <span class="text-muted small">Based on deal probabilities</span>
            </div>
        </div>

        <div class="col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 bg-white p-3">
                <div class="d-flex align-items-center justify-content-between mb-1">
                    <span class="text-muted small fw-semibold text-uppercase">Won Deals</span>
                    <i class="bi bi-trophy-fill text-success fs-5"></i>
                </div>
                <h3 class="fw-bold text-success mb-0">₹@Model.WonValue.ToString("N0")</h3>
                <span class="text-muted small">@Model.WonDealsCount successfully closed deals</span>
            </div>
        </div>

        <div class="col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 bg-white p-3">
                <div class="d-flex align-items-center justify-content-between mb-1">
                    <span class="text-muted small fw-semibold text-uppercase">Total Deals</span>
                    <i class="bi bi-briefcase-fill text-warning fs-5"></i>
                </div>
                <h3 class="fw-bold text-dark mb-0">@Model.TotalCount</h3>
                <span class="text-muted small">Across all pipeline stages</span>
            </div>
        </div>
    </div>

    <!-- Search & Filter Card -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 bg-white">
        <div class="card-body p-3">
            <form method="get" asp-action="Index" class="row g-2 align-items-center">
                <div class="col-md-4">
                    <div class="input-group">
                        <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-search"></i></span>
                        <input type="text" name="search" value="@Model.SearchTerm" class="form-control border-start-0" placeholder="Search opportunity, customer..." />
                    </div>
                </div>
                <div class="col-md-2">
                    <select name="stage" class="form-select">
                        <option value="All" selected="@(string.IsNullOrEmpty(Model.SelectedStage) || Model.SelectedStage == "All")">All Stages</option>
                        @foreach (var stg in OpportunityStage.All)
                        {
                            <option value="@stg" selected="@(Model.SelectedStage == stg)">@stg</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <select name="status" class="form-select">
                        <option value="All" selected="@(string.IsNullOrEmpty(Model.SelectedStatus) || Model.SelectedStatus == "All")">All Statuses</option>
                        @foreach (var s in OpportunityStatus.All)
                        {
                            <option value="@s" selected="@(Model.SelectedStatus == s)">@s</option>
                        }
                    </select>
                </div>
                @if (User.IsInRole(AppRoles.Admin) || User.IsInRole(AppRoles.Manager))
                {
                    <div class="col-md-2">
                        <select name="assignedTo" class="form-select">
                            <option value="All" selected="@(string.IsNullOrEmpty(Model.SelectedAssignedTo) || Model.SelectedAssignedTo == "All")">All Owners</option>
                            @foreach (var u in Model.UsersList)
                            {
                                <option value="@u.Value" selected="@(Model.SelectedAssignedTo == u.Value)">@u.Text</option>
                            }
                        </select>
                    </div>
                }
                <div class="col d-flex gap-2 justify-content-end">
                    <button type="submit" class="btn btn-primary px-3 rounded-3">
                        <i class="bi bi-funnel me-1"></i> Filter
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary px-3 rounded-3">
                        <i class="bi bi-arrow-counterclockwise me-1"></i> Reset
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Opportunities Table -->
    <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-secondary small text-uppercase">
                    <tr>
                        <th class="ps-4">Opportunity</th>
                        <th>Customer</th>
                        <th>Stage</th>
                        <th>Amount</th>
                        <th>Probability</th>
                        <th>Weighted (₹)</th>
                        <th>Close Date</th>
                        <th>Owner</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Opportunities.Any())
                    {
                        foreach (var item in Model.Opportunities)
                        {
                            var weighted = (item.Amount * item.Probability) / 100m;
                            var stageBadge = item.Stage switch
                            {
                                "Qualification" => "bg-secondary-subtle text-secondary",
                                "Proposal" => "bg-info-subtle text-info-emphasis",
                                "Negotiation" => "bg-warning-subtle text-warning-emphasis",
                                "Won" => "bg-success-subtle text-success fw-bold",
                                "Lost" => "bg-danger-subtle text-danger",
                                _ => "bg-light text-dark"
                            };

                            <tr>
                                <td class="ps-4">
                                    <a asp-action="Details" asp-route-id="@item.OpportunityId" class="fw-bold text-dark text-decoration-none">
                                        @item.OpportunityName
                                    </a>
                                </td>
                                <td class="small">
                                    @if (item.Customer != null)
                                    {
                                        <a asp-controller="Customers" asp-action="Details" asp-route-id="@item.Customer.CustomerId" class="text-decoration-none fw-semibold">
                                            @item.Customer.CustomerName
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge rounded-pill px-2 py-1 @stageBadge">@item.Stage</span>
                                </td>
                                <td class="fw-bold text-dark">
                                    ₹@item.Amount.ToString("N0")
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="progress flex-grow-1" style="height: 6px; width: 60px;">
                                            <div class="progress-bar @(item.Probability >= 70 ? "bg-success" : item.Probability >= 30 ? "bg-warning" : "bg-danger")"
                                                 style="width: @item.Probability%"></div>
                                        </div>
                                        <span class="small fw-semibold">@item.Probability%</span>
                                    </div>
                                </td>
                                <td class="fw-semibold text-info small">
                                    ₹@weighted.ToString("N0")
                                </td>
                                <td class="small text-secondary">
                                    @item.ExpectedCloseDate.ToString("dd MMM yyyy")
                                </td>
                                <td class="small text-muted">
                                    @(item.AssignedToUser?.FullName ?? "Unassigned")
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@item.OpportunityId" class="btn btn-outline-secondary" title="View Details">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.OpportunityId" class="btn btn-outline-primary" title="Edit Deal">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        @if (item.Status == OpportunityStatus.Open)
                                        {
                                            <form asp-action="ChangeStage" asp-route-id="@item.OpportunityId" asp-route-stage="@OpportunityStage.Won" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-outline-success" title="Mark as Won">
                                                    <i class="bi bi-check-lg"></i>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="text-center py-5 text-muted">
                                <div class="py-3">
                                    <i class="bi bi-currency-dollar display-6 d-block mb-2 text-secondary opacity-50"></i>
                                    <h5>No opportunities found</h5>
                                    <p class="small text-muted mb-3">Create a new opportunity or convert a qualified lead to start sales pipeline forecasting.</p>
                                    <a asp-action="Create" class="btn btn-sm btn-primary rounded-pill px-3">
                                        <i class="bi bi-plus me-1"></i> New Opportunity
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPages > 1)
        {
            <div class="card-footer bg-white d-flex justify-content-between align-items-center py-3 border-top">
                <span class="text-muted small">
                    Showing page <strong>@Model.CurrentPage</strong> of <strong>@Model.TotalPages</strong>
                </span>
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                            <a class="page-link" asp-action="Index"
                               asp-route-page="@(Model.CurrentPage - 1)"
                               asp-route-search="@Model.SearchTerm"
                               asp-route-stage="@Model.SelectedStage"
                               asp-route-status="@Model.SelectedStatus"
                               asp-route-assignedTo="@Model.SelectedAssignedTo">Previous</a>
                        </li>
                        @for (int p = 1; p <= Model.TotalPages; p++)
                        {
                            <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                                <a class="page-link" asp-action="Index"
                                   asp-route-page="@p"
                                   asp-route-search="@Model.SearchTerm"
                                   asp-route-stage="@Model.SelectedStage"
                                   asp-route-status="@Model.SelectedStatus"
                                   asp-route-assignedTo="@Model.SelectedAssignedTo">@p</a>
                            </li>
                        }
                        <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                            <a class="page-link" asp-action="Index"
                               asp-route-page="@(Model.CurrentPage + 1)"
                               asp-route-search="@Model.SearchTerm"
                               asp-route-stage="@Model.SelectedStage"
                               asp-route-status="@Model.SelectedStatus"
                               asp-route-assignedTo="@Model.SelectedAssignedTo">Next</a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>
